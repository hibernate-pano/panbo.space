---
import BaseLayout from '../layouts/BaseLayout.astro'
import { siteConfig } from '../data/site'
import {
  formatDate,
  getAllPosts,
  getLatestPosts,
  getReadingTime,
  getTopicMap,
  toPostPath,
  trackHue,
  trackLabels,
  type TrackKey,
} from '../lib/posts'

const allPosts = await getAllPosts()
const latestPosts = await getLatestPosts(6)
const topicMap = await getTopicMap()

const countByTrack = (key: TrackKey) => allPosts.filter((post) => post.data.track === key).length

const trackMeta: Record<string, { desc: string }> = {
  thinking: { desc: '职业判断、长期主义与个人系统' },
  work: { desc: '组织约束、项目推进与真实现场' },
  philosophy: { desc: '哲学思辨、存在与意义的长期阅读' },
  psychology: { desc: '人格、潜意识与心灵的现代解读' },
  engineering: { desc: '系统、架构与工程判断' },
  games: { desc: '玩过的游戏与做过的设计' },
}

// Only surface tracks that actually have notes — no empty shells
const tracks = (['thinking', 'work', 'philosophy', 'psychology', 'engineering', 'games'] as TrackKey[])
  .map((key) => ({ key, label: trackLabels[key], count: countByTrack(key), ...trackMeta[key] }))
  .filter((track) => track.count > 0 && track.desc)

// Ledger line: total plus the three largest tracks
const stats = [
  { label: 'Notes', value: allPosts.length, href: '/archive' },
  ...[...tracks]
    .sort((a, b) => b.count - a.count)
    .slice(0, 3)
    .map((track) => ({
      label: track.label,
      value: track.count,
      href: `/archive?track=${track.key}`,
    })),
]

const topics = [...topicMap.entries()]
  .sort((left, right) => right[1].length - left[1].length)
  .slice(0, 6)
  .map(([topic, posts]) => ({
    name: topic,
    post: posts[0]?.data.title ?? '',
    href: `/archive?topic=${encodeURIComponent(topic)}`,
  }))
---

<BaseLayout mainClass="page-home">
  <section class="hero">
    <div class="hero__inner">
      <p class="hero__eyebrow rise">{siteConfig.hero.eyebrow}</p>
      <h1 class="hero__title rise">{siteConfig.hero.title}</h1>
      <p class="hero__summary rise">{siteConfig.hero.summary}</p>
      <div class="hero__cta rise">
        <a class="btn btn--primary" href={siteConfig.hero.primaryCta.href}>
          {siteConfig.hero.primaryCta.label}
        </a>
        <a class="btn btn--ghost" href={siteConfig.hero.secondaryCta.href}>
          {siteConfig.hero.secondaryCta.label}
        </a>
      </div>
      <div class="hero__tracks rise">
        {tracks.map((track) => (
          <a class="hero__track" href={`/archive?track=${track.key}`} style={`--track-hue: ${trackHue[track.key]}`}>
            {track.label}
            <span class="hero__track-count">{track.count}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="stats">
    {stats.map((stat) => (
      <a class="stats__item" href={stat.href}>
        <span class="stats__value">{stat.value}</span>
        <span class="stats__label">{stat.label}</span>
      </a>
    ))}
  </section>

  <section class="section">
    <div class="section__header">
      <h2 class="section__title">最新文章</h2>
      <a class="section__link" href="/archive">全部归档 →</a>
    </div>
    <div class="feed-list">
      {latestPosts.map((post) => (
        <a
          class="feed-card animate-on-scroll"
          href={toPostPath(post)}
          style={`--track-hue: ${trackHue[post.data.track]}`}
        >
          <span class="feed-card__media">
            <img
              src={`/og/${post.data.slug}.svg`}
              alt=""
              loading="lazy"
              width="1200"
              height="630"
            />
          </span>
          <span class="feed-card__body">
            <span class="feed-card__meta">
              <span class="feed-card__track">{trackLabels[post.data.track]}</span>
              <span>{formatDate(post.data.publishedAt)}</span>
              <span>{getReadingTime(post.body ?? '')} 分钟</span>
            </span>
            <span class="feed-card__title">{post.data.title}</span>
            <span class="feed-card__summary">{post.data.summary}</span>
            <span class="feed-card__footer">
              <span class="feed-card__byline">
                <span class="feed-card__avatar" aria-hidden="true">P</span>
                {siteConfig.author.name}
              </span>
              {post.data.topic && <span class="tag tag--accent">{post.data.topic}</span>}
            </span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="section section--bordered">
    <div class="section__header">
      <h2 class="section__title">栏目</h2>
      <a class="section__link" href="/archive">浏览全部 →</a>
    </div>
    <div class="track-grid">
      {tracks.map((track) => (
        <a
          class="track-card animate-on-scroll"
          href={`/archive?track=${track.key}`}
          style={`--track-hue: ${trackHue[track.key]}`}
        >
          <span class="track-card__name">{track.label}</span>
          <span class="track-card__desc">{track.desc}</span>
          <span class="track-card__count">{track.count} 篇笔记</span>
        </a>
      ))}
    </div>
  </section>

  {topics.length > 0 && (
    <section class="section">
      <div class="section__header">
        <h2 class="section__title">主题</h2>
        <a class="section__link" href="/topics">主题档案 →</a>
      </div>
      <div class="topic-list">
        {topics.map((topic) => (
          <a class="topic-item animate-on-scroll" href={topic.href}>
            <div class="topic-item__left">
              <span class="topic-item__name">{topic.name}</span>
              <span class="topic-item__post">{topic.post}</span>
            </div>
            <span class="topic-item__count">→</span>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
