---
import { siteConfig } from '../data/site'
const year = new Date().getFullYear()
---

<footer class="foot">
  <div class="foot__grid wrap">
    <div class="foot__brand">
      <b>panbo.space</b>
      <p>{siteConfig.description}</p>
    </div>

    <div class="foot__col">
      <h5>内容</h5>
      <ul>
        <li><a href="/archive">归档</a></li>
        <li><a href="/topics">主题</a></li>
        <li><a href="/tags">标签</a></li>
        <li><a href="/search">搜索</a></li>
      </ul>
    </div>

    <div class="foot__col">
      <h5>作品</h5>
      <ul>
        <li><a href="/projects">在研项目</a></li>
        <li><a href={siteConfig.social.github} target="_blank" rel="noreferrer">GitHub ↗</a></li>
        <li><a href={siteConfig.social.x} target="_blank" rel="noreferrer">X ↗</a></li>
      </ul>
    </div>

    <div class="foot__col">
      <h5>关于</h5>
      <ul>
        <li><a href="/about">关于我</a></li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </div>
  </div>

  <div class="foot__bottom wrap">
    <span>© {year} {siteConfig.author.name} · {siteConfig.author.role} @ {siteConfig.author.company}</span>
    <span>PANBO.SPACE</span>
  </div>
</footer>
