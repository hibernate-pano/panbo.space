---
import BaseLayout from '../layouts/BaseLayout.astro'
import { siteConfig } from '../data/site'
---

<BaseLayout title="About" description="About Panbo's work, writing topics, and the direction of this blog.">
  <div class="about-page">
    <header class="about-header">
      <p class="hero__eyebrow">About</p>
      <h1 class="about-header__title">{siteConfig.author.name}</h1>
      <p class="about-header__intro">
        {siteConfig.author.role} at {siteConfig.author.company}. This site is a personal research archive —
        a place for writing that is worth revisiting, worth building on, and worth searching when you need it.
      </p>
    </header>

    <section class="about-section">
      <h2 class="about-section__title">Current Work</h2>
      <div class="about-section__content">
        <p>Working on enterprise systems with a focus on backend architecture, distributed systems, and platform engineering. Tech stack includes Java, Spring Boot, React, and TypeScript in a banking environment.</p>
      </div>
    </section>

    <section class="about-section">
      <h2 class="about-section__title">Writing</h2>
      <div class="about-section__content">
        <p>This archive covers three main tracks:</p>
        <p><strong>Engineering</strong> — System design, architecture decisions, and technical depth. The kind of writing that tries to explain why something works, not just how.</p>
        <p><strong>Work Notes</strong> — Real observations from working in complex organizations. Process, people, and the unwritten rules that actually matter.</p>
        <p><strong>Thinking</strong> — Long-form thinking on learning, growth, and the mental models that shape decisions.</p>
      </div>
    </section>

    <section class="about-section">
      <h2 class="about-section__title">This Site</h2>
      <div class="about-section__content">
        <p>Not a blog in the traditional sense — more like a personal wiki that grows over time. The goal is to write things worth reading years later, not chasing trends or optimizing for metrics.</p>
        <p>Start at the <a href="/archive">Archive</a> to browse by topic, or use <a href="/search">Search</a> to find something specific.</p>
      </div>
    </section>

    <section class="about-section">
      <h2 class="about-section__title">Connect</h2>
      <div class="about-section__content">
        <p>
          <a href={siteConfig.social.github} target="_blank" rel="noreferrer">GitHub</a> ·
          <a href={siteConfig.social.x} target="_blank" rel="noreferrer">X / Twitter</a> ·
          <a href="/rss.xml">RSS Feed</a>
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-page {
    padding: var(--space-8) 0;
    max-width: var(--reading-width);
  }

  .about-header {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-7);
    border-bottom: 1px solid var(--color-border);
  }

  .about-header__title {
    font-size: clamp(2.25rem, 4vw, 3rem);
    font-weight: 600;
    margin-bottom: var(--space-5);
  }

  .about-header__intro {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.75;
  }

  .about-section {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: var(--space-6);
    margin-bottom: var(--space-7);
    padding-bottom: var(--space-7);
    border-bottom: 1px solid var(--color-border);
  }

  .about-section:last-child {
    border-bottom: none;
  }

  .about-section__title {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding-top: 0.25rem;
  }

  .about-section__content {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.75;
  }

  .about-section__content p + p {
    margin-top: var(--space-4);
  }

  .about-section__content strong {
    color: var(--color-text);
    font-weight: 500;
  }

  .about-section__content a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 34%, transparent);
    transition: text-decoration-color var(--duration-fast);
  }

  .about-section__content a:hover {
    text-decoration-color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .about-section {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
</style>
