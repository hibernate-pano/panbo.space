---
import { render } from 'astro:content'
import MermaidRuntime from '../../components/MermaidRuntime.astro'
import TableOfContents from '../../components/TableOfContents.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { formatDate, getAllPosts, getReadingTime, toPostPath, trackHue, trackLabels } from '../../lib/posts'
import { formatTagLabel, getPostTags, getVisiblePostTags, toTagPath } from '../../lib/post-tags'
import { siteConfig } from '../../data/site'
import { toTopicSlug } from '../../lib/slug'

export const getStaticPaths = async () => {
  const posts = await getAllPosts()
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content, headings } = await render(post)
const readingTime = getReadingTime(post.body ?? '')
const ogImage = `/og/${post.data.slug}.svg`
const sectionCount = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3 && heading.text !== '目录').length
const hasToc = sectionCount >= 3
const tags = getPostTags(post)
const visibleTags = getVisiblePostTags(post, 4)
const metaTags = [post.data.topic, ...tags].filter((value): value is string => Boolean(value))

// Related stories: same track first, backfill with latest
const allPosts = await getAllPosts()
const sameTrack = allPosts.filter((entry) => entry.data.slug !== post.data.slug && entry.data.track === post.data.track)
const fallback = allPosts.filter((entry) => entry.data.slug !== post.data.slug && entry.data.track !== post.data.track)
const related = [...sameTrack, ...fallback].slice(0, 3)
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  image={ogImage}
  canonicalPath={toPostPath(post)}
  type="article"
  showProgress
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  tags={metaTags}
>
  <div class:list={['post-page', hasToc ? 'post-page--with-toc' : 'post-page--no-toc']}>
    <div class:list={['post-layout', hasToc ? 'post-layout--with-toc' : '']}>
      <div class="post-column">
        <header class="post-header">
      <!-- HN badge row: New Story · read time · track -->
      <div class="post-header__badges">
        <a class="badge-pill" href={`/archive?track=${post.data.track}`} style={`--track-hue: ${trackHue[post.data.track]}`}>
          {trackLabels[post.data.track]}
        </a>
        <span class="badge-pill">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          {readingTime} 分钟
        </span>
        {post.data.updatedAt && (
          <span class="badge-pill">
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4v5h-5"/></svg>
            更新于 {formatDate(post.data.updatedAt)}
          </span>
        )}
      </div>

      <h1 class="post-header__title">{post.data.title}</h1>

      <!-- TLDR first: give the answer before the cover art -->
      <!-- TLDR fold — HN signature interaction -->
      {post.data.summary && (
        <details class="tldr">
          <summary>
            摘要
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round" style="fill:none"/></svg>
          </summary>
          <p class="tldr__panel">{post.data.summary}</p>
        </details>
      )}


      <!-- HN byline: "by author · date" with border top+bottom, tools right -->
      <div class="post-header__byline">
        <span class="post-header__byline-author">
          <span class="post-header__avatar" aria-hidden="true">P</span>
          <strong>{siteConfig.author.name}</strong>
          <span class="post-header__byline-dot" aria-hidden="true"></span>
          <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
        </span>
        <span class="post-header__tools">
          <button type="button" class="badge-pill badge-pill--icon" data-copy-link data-tip="复制链接" aria-label="Copy link">
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          </button>
          <a class="badge-pill badge-pill--icon tip-left" href="/rss.xml" data-tip="RSS" aria-label="RSS feed">
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.5"/></svg>
          </a>
        </span>
      </div>

      <!-- Featured image — HN story cover -->
      <div class="post-header__cover">
        <img
          src={ogImage}
          alt={`Cover — ${post.data.title}`}
          width="1200"
          height="630"
          fetchpriority="high"
        />
      </div>

        </header>

        <article class="post-content">
        <div class="prose">
          <Content />
        </div>

        {(post.data.topic || post.data.series || visibleTags.length > 0) && (
          <footer class="post-taxonomy">
            <div class="post-taxonomy__chips">
              {post.data.topic && (
                <a href={`/topics/${toTopicSlug(post.data.topic)}`} class="tag tag--accent">
                  {post.data.topic}
                </a>
              )}
              {post.data.series && <span class="tag">{post.data.series}</span>}
              {visibleTags.map((tag) => (
                <a href={toTagPath(tag)} class="tag">
                  {formatTagLabel(tag)}
                </a>
              ))}
            </div>
          </footer>
        )}

        {related.length > 0 && (
          <section class="post-related">
            <h2 class="post-related__title">继续阅读</h2>
            <div class="feed-list">
              {related.map((entry) => (
                <a class="feed-card" href={toPostPath(entry)} style={`--track-hue: ${trackHue[entry.data.track]}`}>
                  <span class="feed-card__media">
                    <img
                      src={`/og/${entry.data.slug}.svg`}
                      alt=""
                      loading="lazy"
                      width="1200"
                      height="630"
                    />
                  </span>
                  <span class="feed-card__body">
                    <span class="feed-card__meta">
                      <span class="feed-card__track">{trackLabels[entry.data.track]}</span>
                      <span>{formatDate(entry.data.publishedAt)}</span>
                      <span>{getReadingTime(entry.body ?? '')} 分钟</span>
                    </span>
                    <span class="feed-card__title">{entry.data.title}</span>
                    <span class="feed-card__summary">{entry.data.summary}</span>
                    <span class="feed-card__footer">
                      <span class="feed-card__byline">
                        <span class="feed-card__avatar" aria-hidden="true">P</span>
                        {siteConfig.author.name}
                      </span>
                      {entry.data.topic && <span class="tag tag--accent">{entry.data.topic}</span>}
                    </span>
                  </span>
                </a>
              ))}
            </div>
          </section>
        )}
        </article>
      </div>

      {hasToc && (
        <aside class="post-sidebar">
          <div class="sidebar-section">
            <p class="sidebar-section__title">本文目录</p>
            <TableOfContents headings={headings} />
          </div>
        </aside>
      )}
    </div>
  </div>

  <button type="button" class="back-to-top" data-back-to-top aria-label="回到顶部">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 19V5" />
      <path d="m5 12 7-7 7 7" />
    </svg>
  </button>

  <MermaidRuntime />
</BaseLayout>

<style>
  @media (max-width: 1100px) {
    .post-sidebar {
      position: static;
      display: flex;
      gap: var(--space-6);
      border-top: 1px solid var(--border);
      padding-top: var(--space-6);
      max-height: none;
    }
  }
</style>

<script>
  // Back-to-top: show after 600px of scroll
  const backToTop = document.querySelector<HTMLButtonElement>('[data-back-to-top]')

  if (backToTop) {
    const syncBackToTop = () => {
      backToTop.classList.toggle('is-visible', window.scrollY > 600)
    }

    window.addEventListener('scroll', syncBackToTop, { passive: true })
    syncBackToTop()

    backToTop.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' })
    })
  }

  const copyButtons = document.querySelectorAll<HTMLButtonElement>('[data-copy-link]')

  for (const button of copyButtons) {
    button.addEventListener('click', async () => {
      const url = window.location.href
      try {
        await navigator.clipboard.writeText(url)
        button.setAttribute('data-tip', 'Copied!')
      } catch {
        button.setAttribute('data-tip', url)
      }
      window.setTimeout(() => button.setAttribute('data-tip', 'Copy link'), 1600)
    })
  }
</script>
