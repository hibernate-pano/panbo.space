---
import type { PostEntry } from '../lib/posts'
import { formatDate, getReadingTime, toPostPath, trackLabels } from '../lib/posts'
import { formatTagLabel, getVisiblePostTags, toTagPath } from '../lib/post-tags'
import { toTopicSlug } from '../lib/slug'

type Props = {
  post: PostEntry
  compact?: boolean
}

const { post, compact = false } = Astro.props
const postPath = toPostPath(post)
const readingTime = getReadingTime(post.body ?? '')
const tags = getVisiblePostTags(post, compact ? 2 : 3)
---

<article class="post-card">
  <span class="post-card__date">{formatDate(post.data.publishedAt)}</span>

  <div class="post-card__main">
    <a href={postPath}>
      <h3 class="post-card__title">{post.data.title}</h3>
      <p class="post-card__summary">{post.data.summary}</p>
    </a>

    <div class="post-card__footer">
      <div class="post-card__tags">
        <span class="tag">{trackLabels[post.data.track]}</span>
        {post.data.topic && (
          <a href={`/topics/${toTopicSlug(post.data.topic)}`} class="tag tag--accent">
            {post.data.topic}
          </a>
        )}
        {tags.map((tag) => (
          <a href={toTagPath(tag)} class="tag">
            {formatTagLabel(tag)}
          </a>
        ))}
      </div>
      <span class="post-card__readmore">{readingTime} 分钟</span>
    </div>
  </div>

  <a class="post-card__arrow" href={postPath} aria-label={post.data.title}>
    →
  </a>
</article>
