---
import type { PostEntry } from '../lib/posts'
import { formatDate, getReadingTime, toPostPath, trackLabels } from '../lib/posts'
import { formatTagLabel, getVisiblePostTags, toTagPath } from '../lib/post-tags'
import { toTopicSlug } from '../lib/slug'

type Props = {
  post: PostEntry
  compact?: boolean
}

const { post, compact = false } = Astro.props
const postPath = toPostPath(post)
const readingTime = getReadingTime(post.body ?? '')
const tags = getVisiblePostTags(post, compact ? 2 : 3)
---

<article class="post-card">
  <a class="post-card__link" href={postPath}>
    <div class="post-card__meta">
      <span>{trackLabels[post.data.track]}</span>
      {post.data.topic && <span>{post.data.topic}</span>}
      <span>{formatDate(post.data.publishedAt)}</span>
      <span>{readingTime} min</span>
    </div>

    <h3 class="post-card__title">{post.data.title}</h3>
    <p class="post-card__summary">{post.data.summary}</p>
  </a>

  <div class="post-card__footer">
    <div class="post-card__tags">
      {post.data.topic && (
        <a href={`/topics/${toTopicSlug(post.data.topic)}`} class="tag">
          {post.data.topic}
        </a>
      )}
      {post.data.series && <span class="tag">{post.data.series}</span>}
      {tags.map((tag) => (
        <a href={toTagPath(tag)} class="tag">
          {formatTagLabel(tag)}
        </a>
      ))}
    </div>

    <a class="post-card__readmore" href={postPath}>
      Read →
    </a>
  </div>
</article>