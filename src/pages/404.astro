---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="404" description="页面不存在。">
  <section class="empty-state">
    <p class="page-header__eyebrow">404</p>
    <h1>这页不存在</h1>
    <p>链接可能已经迁移。你可以回到归档页继续找，也可以直接用全文搜索。</p>
    <div class="hero__cta">
      <a class="btn btn--primary" href="/archive">浏览归档</a>
      <a class="btn btn--ghost" href="/search">打开搜索</a>
    </div>
  </section>
</BaseLayout>
