---
const currentPath = Astro.url.pathname
const currentTrack = Astro.url.searchParams.get('track') ?? 'all'

// Band 2 nav — HN: READ / TOP BLOGS / WRITE NOW / ABOUT
const navItems = [
  { href: '/archive', label: 'Archive', matches: ['/archive'] },
  { href: '/tags', label: 'Index', matches: ['/topics/', '/tags'] },
  { href: '/about', label: 'About', matches: ['/about'] },
  { href: '/search', label: 'Search', matches: ['/search'] },
]

// Band 3 track tabs — replaces HN's category bar
const tracks = [
  { key: 'all', label: 'All', href: '/archive' },
  { key: 'thinking', label: 'Thinking', href: '/archive?track=thinking' },
  { key: 'work', label: 'Work Notes', href: '/archive?track=work' },
  { key: 'philosophy', label: 'Philosophy', href: '/archive?track=philosophy' },
  { key: 'engineering', label: 'Engineering', href: '/archive?track=engineering' },
  { key: 'games', label: 'Games', href: '/archive?track=games' },
]

const isActive = (matches: string[], href: string) =>
  currentPath === href || matches.some((match) => currentPath === match || currentPath.startsWith(match))
---

<header class="site-header">
  <!-- Band 1: bright green brand bar -->
  <div class="site-header__bar">
    <div class="site-header__inner">
      <a class="site-header__discover" href="/search" aria-label="Discover anything — search">
        Discover Anything
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
          <circle cx="11" cy="11" r="7"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
      </a>

      <a class="site-header__brand" href="/" aria-label="panbo.space home">
        <svg class="site-header__brand-mark" width="19" height="22" viewBox="0 0 7 8" shape-rendering="crispEdges" aria-hidden="true">
          <rect x="0" y="0" width="3" height="1"/>
          <rect x="0" y="1" width="1" height="1"/>
          <rect x="2" y="1" width="1" height="1"/>
          <rect x="0" y="2" width="1" height="1"/>
          <rect x="2" y="2" width="1" height="1"/>
          <rect x="0" y="3" width="3" height="1"/>
          <rect x="0" y="4" width="1" height="4"/>
        </svg>
        <span class="site-header__brand-name">panbo<span class="site-header__brand-dot">.</span>space</span>
        <span class="site-header__cursor" aria-hidden="true"></span>
      </a>

      <div class="site-header__actions">
        <a class="site-header__action" href="/search" aria-label="Search (Ctrl K)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
            <circle cx="11" cy="11" r="7"/>
            <path d="m21 21-4.35-4.35"/>
          </svg>
          <kbd>Ctrl K</kbd>
        </a>
        <a class="site-header__action" href="/rss.xml" aria-label="RSS Feed" title="RSS">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
            <path d="M4 11a9 9 0 0 1 9 9"/>
            <path d="M4 4a16 16 0 0 1 16 16"/>
            <circle cx="5" cy="19" r="1.6"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Band 2: mid-green nav bar (uppercase, centered — HN style) -->
  <div class="site-header__navbar">
    <nav class="site-header__nav" aria-label="Primary">
      {navItems.map((item) => (
        <a
          href={item.href}
          data-nav-link
          data-match={item.matches.join(',')}
          class:list={[isActive(item.matches, item.href) && 'is-active']}
          aria-current={isActive(item.matches, item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>

  <!-- Band 3: deep teal track bar -->
  <div class="site-header__trackbar">
    <div class="site-header__inner">
      <nav class="site-header__tracks" aria-label="Tracks">
        {tracks.map((track) => (
          <a
            href={track.href}
            class:list={['track-chip', currentTrack === track.key && 'is-active']}
            data-track-link
            data-track={track.key}
            aria-current={currentTrack === track.key ? 'page' : undefined}
          >
            {track.label}
          </a>
        ))}
      </nav>
      <span class="site-header__prompt" aria-hidden="true">$ panbo --archive --all</span>
    </div>
  </div>
</header>

<style>
  @media (max-width: 768px) {
    .site-header__tracks {
      height: 56px;
    }
    .track-chip {
      font-size: 0.88rem;
      padding: 7px 12px;
    }
    .site-header__prompt,
    .site-header__discover {
      display: none;
    }
  }
</style>
