---
import '@fontsource/source-serif-4/400.css'
import '@fontsource/source-serif-4/600.css'
import '@fontsource/noto-serif-sc/400.css'
import '@fontsource/noto-serif-sc/600.css'
import '@fontsource/source-sans-3/400.css'
import '@fontsource/source-sans-3/500.css'
import '@fontsource/source-sans-3/600.css'
import '@fontsource/noto-sans-sc/400.css'
import '@fontsource/noto-sans-sc/500.css'
import '@fontsource/noto-sans-sc/600.css'
import '@fontsource/ibm-plex-mono/400.css'
import '@fontsource/ibm-plex-mono/500.css'
import '../styles/global.css'
import '../styles/theme-hsbc.css'
import { siteConfig } from '../data/site'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'

type Props = {
  title?: string
  description?: string
  image?: string
  canonicalPath?: string
  type?: 'website' | 'article'
  showProgress?: boolean
  publishedAt?: Date
  updatedAt?: Date
  tags?: string[]
  mainClass?: string
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = '/og/home.svg',
  canonicalPath = Astro.url.pathname,
  type = 'website',
  showProgress = false,
  publishedAt,
  updatedAt,
  tags = [],
  mainClass,
} = Astro.props as Props

const pageTitle = title === siteConfig.title ? siteConfig.title : `${title} · ${siteConfig.title}`
const canonicalUrl = new URL(canonicalPath, siteConfig.site).toString()
const imageUrl = image.startsWith('http') ? image : new URL(image, siteConfig.site).toString()

const themeBootstrapScript = `
  (() => {
    const storageKey = 'panbo-theme';
    const root = document.documentElement;
    const themeMetaColors = {
      'light': '#f6f0e6',
      'dark': '#201d18',
      'hsbc-light': '#FFFFFF',
      'hsbc-dark': '#0D1117'
    };
    const setThemeColor = (theme) => {
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', themeMetaColors[theme] || themeMetaColors['light']);
    };
    try {
      const saved = localStorage.getItem(storageKey);
      const validThemes = ['light', 'dark', 'hsbc-light', 'hsbc-dark'];
      const theme = validThemes.includes(saved) ? saved : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      root.dataset.theme = theme;
      setThemeColor(theme);
    } catch {
      const theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      root.dataset.theme = theme;
      setThemeColor(theme);
    }
  })();
`

const runtimeScript = `
  (() => {
    let tocObserver;
    const themeStorageKey = 'panbo-theme';
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');

    // Reading progress
    const syncProgress = () => {
      const progress = document.querySelector('[data-reading-progress]');
      if (!progress) return;
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = scrollable > 0 ? Math.min(window.scrollY / scrollable, 1) : 0;
      progress.style.transform = 'scaleX(' + ratio + ')';
    };

    // Header scroll state
    const syncHeaderState = () => {
      const header = document.querySelector('.site-header');
      if (!header) return;
      header.classList.toggle('site-header--scrolled', window.scrollY > 8);
    };

    // Active nav link
    const syncActiveNav = () => {
      const pathname = window.location.pathname;
      document.querySelectorAll('[data-nav-link]').forEach((link) => {
        const href = link.getAttribute('href') || '/';
        const matches = (link.getAttribute('data-match') || href)
          .split(',')
          .map((value) => value.trim())
          .filter(Boolean);
        const active = pathname === href || matches.some((match) => pathname === match || (match !== '/' && pathname.startsWith(match)));
        link.classList.toggle('is-active', active);
        link.setAttribute('aria-current', active ? 'page' : 'false');
      });
    };

    // Table of contents
    const setupToc = () => {
      tocObserver?.disconnect();

      const links = [...document.querySelectorAll('[data-toc-link]')];
      const headings = links
        .map((link) => document.getElementById(link.getAttribute('data-toc-link') || ''))
        .filter((heading) => heading instanceof HTMLElement);

      if (!links.length || !headings.length) return;

      const updateActiveHeading = () => {
        const currentHeading = [...headings].reverse().find((heading) => heading.getBoundingClientRect().top <= 120) || headings[0];

        links.forEach((link) => {
          link.classList.toggle('is-active', link.getAttribute('data-toc-link') === currentHeading.id);
        });
      };

      tocObserver = new IntersectionObserver(updateActiveHeading, {
        rootMargin: '-80px 0px -70% 0px',
        threshold: [0, 1],
      });

      headings.forEach((heading) => tocObserver.observe(heading));
      updateActiveHeading();
    };

    // Search focus
    const focusSearchInput = () => {
      document.querySelector('[data-search-input]')?.focus();
    };

    const isEditableTarget = (event) => {
      const target = event.target;
      return (
        target instanceof HTMLElement &&
        (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName))
      );
    };

    const handleKeydown = (event) => {
      if (!(event.metaKey || event.ctrlKey) || event.key.toLowerCase() !== 'k') return;
      if (isEditableTarget(event) && window.location.pathname !== '/search') return;

      event.preventDefault();
      if (window.location.pathname === '/search') {
        focusSearchInput();
        return;
      }

      window.location.href = '/search';
    };

    // Theme
    const validThemes = ['light', 'dark', 'hsbc-light', 'hsbc-dark'];
    const themeMetaColors = {
      'light': '#f6f0e6',
      'dark': '#201d18',
      'hsbc-light': '#FFFFFF',
      'hsbc-dark': '#0D1117'
    };

    const getStoredTheme = () => {
      try {
        const value = localStorage.getItem(themeStorageKey);
        return validThemes.includes(value) ? value : null;
      } catch {
        return null;
      }
    };

    const applyTheme = (theme, persist = false) => {
      const root = document.documentElement;
      root.dataset.theme = theme;
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', themeMetaColors[theme] || themeMetaColors['light']);

      if (persist) {
        try {
          localStorage.setItem(themeStorageKey, theme);
        } catch {}
      }

      updateThemeSelectorUI(theme);
      updateThemeIcon(theme);
    };

    const setupThemeToggle = () => {
      // Theme selector dropdown
      const selector = document.querySelector('[data-theme-selector]');
      const trigger = document.querySelector('[data-theme-toggle]');
      const options = document.querySelectorAll('[data-theme-option]');
      const validThemes = ['light', 'dark', 'hsbc-light', 'hsbc-dark'];

      if (selector && trigger) {
        // Toggle dropdown
        trigger.addEventListener('click', (e) => {
          e.stopPropagation();
          selector.classList.toggle('is-open');
          trigger.setAttribute('aria-expanded', selector.classList.contains('is-open') ? 'true' : 'false');
        });

        // Close on outside click
        document.addEventListener('click', () => {
          selector.classList.remove('is-open');
          trigger.setAttribute('aria-expanded', 'false');
        });

        // Prevent dropdown close when clicking inside
        selector.addEventListener('click', (e) => e.stopPropagation());

        // Theme option selection
        options.forEach((option) => {
          option.addEventListener('click', () => {
            const theme = option.getAttribute('data-theme-option') || 'light';
            if (validThemes.includes(theme)) {
              applyTheme(theme, true);
              updateThemeSelectorUI(theme);
              selector.classList.remove('is-open');
              trigger.setAttribute('aria-expanded', 'false');
            }
          });
        });

        // Keyboard shortcut for theme switching (Cmd/Ctrl + number)
        document.addEventListener('keydown', (e) => {
          // Skip if in input/textarea
          if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
          
          // Cmd/Ctrl + 1-4 for theme switching
          if ((e.metaKey || e.ctrlKey) && ['1', '2', '3', '4'].includes(e.key)) {
            e.preventDefault();
            const themeMap = { '1': 'light', '2': 'dark', '3': 'hsbc-light', '4': 'hsbc-dark' };
            const theme = themeMap[e.key];
            if (theme) {
              applyTheme(theme, true);
              updateThemeSelectorUI(theme);
            }
          }
        });

        // Keyboard navigation
        trigger.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            selector.classList.remove('is-open');
            trigger.setAttribute('aria-expanded', 'false');
          }
        });
      }
    };

    const updateThemeSelectorUI = (currentTheme) => {
      const options = document.querySelectorAll('[data-theme-option]');
      options.forEach((option) => {
        const theme = option.getAttribute('data-theme-option');
        option.classList.toggle('is-active', theme === currentTheme);
      });
    };

    const updateThemeIcon = (theme) => {
      const trigger = document.querySelector('[data-theme-toggle]');
      if (trigger) {
        const isDark = theme.includes('dark');
        trigger.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
        
        // Create main icon SVG
        const iconSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        iconSvg.setAttribute('width', '14');
        iconSvg.setAttribute('height', '14');
        iconSvg.setAttribute('viewBox', '0 0 24 24');
        iconSvg.setAttribute('fill', 'none');
        iconSvg.setAttribute('stroke', 'currentColor');
        iconSvg.setAttribute('stroke-width', '2');
        iconSvg.setAttribute('stroke-linecap', 'round');
        iconSvg.setAttribute('stroke-linejoin', 'round');
        
        if (isDark) {
          iconSvg.innerHTML = '<circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>';
        } else {
          iconSvg.innerHTML = '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>';
        }

        // Create chevron SVG
        const chevronSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        chevronSvg.setAttribute('class', 'theme-selector__chevron');
        chevronSvg.setAttribute('width', '12');
        chevronSvg.setAttribute('height', '12');
        chevronSvg.setAttribute('viewBox', '0 0 24 24');
        chevronSvg.setAttribute('fill', 'none');
        chevronSvg.setAttribute('stroke', 'currentColor');
        chevronSvg.setAttribute('stroke-width', '2');
        chevronSvg.setAttribute('stroke-linecap', 'round');
        chevronSvg.setAttribute('stroke-linejoin', 'round');
        chevronSvg.innerHTML = '<polyline points="6 9 12 15 18 9"/>';

        // Clear and rebuild trigger content
        trigger.innerHTML = '';
        trigger.appendChild(iconSvg);
        trigger.appendChild(chevronSvg);
      }
    };

    const syncTheme = () => {
      const storedTheme = getStoredTheme();
      const theme = storedTheme ?? (prefersDark.matches ? 'dark' : 'light');
      applyTheme(theme);
    };

    // Scroll animations
    const setupScrollAnimations = () => {
      const elements = document.querySelectorAll('.animate-on-scroll');
      if (!elements.length) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );

      elements.forEach((el) => observer.observe(el));
    };

    const initPage = () => {
      syncProgress();
      syncHeaderState();
      syncActiveNav();
      setupToc();
      setupThemeToggle();
      syncTheme();
      setupScrollAnimations();
      // Update theme selector UI based on current theme
      const currentTheme = document.documentElement.dataset.theme;
      updateThemeSelectorUI(currentTheme);
    };

    // Event listeners
    window.addEventListener('scroll', () => {
      syncProgress();
      syncHeaderState();
    }, { passive: true });

    window.addEventListener('resize', () => {
      syncProgress();
      setupToc();
    });

    window.addEventListener('keydown', handleKeydown);

    prefersDark.addEventListener('change', () => {
      if (getStoredTheme()) return;
      syncTheme();
    });

    document.addEventListener('astro:page-load', initPage);

    initPage();
  })();
`
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author.name} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:creator" content="@HibernatePano" />
    <meta name="theme-color" content="#f6f0e6" />
    <script is:inline set:html={themeBootstrapScript}></script>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    {type === 'article' &&
      tags.map((tag) => <meta property="article:tag" content={tag} />)}
  </head>
  <body>
    {showProgress && (
      <div class="reading-progress">
        <div class="reading-progress__bar" data-reading-progress></div>
      </div>
    )}

    <a href="#main" class="skip-link">Skip to content</a>

    <div class="site-shell">
      <SiteHeader />
      <main id="main" class:list={['site-main', mainClass]} data-pagefind-body>
        <slot />
      </main>
      <SiteFooter />
    </div>

    <script is:inline set:html={runtimeScript}></script>
  </body>
</html>
