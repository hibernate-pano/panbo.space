<script>
  import mermaid from 'mermaid'

  const upgradeBlocks = () => {
    const blocks = document.querySelectorAll('pre[data-language="mermaid"], pre > code.language-mermaid')

    for (const block of blocks) {
      const pre = block instanceof HTMLElement && block.matches('pre') ? block : block.closest('pre')
      if (!pre) continue

      // Read from the <code> element, not the <pre>: the code-copy button is
      // appended to the <pre>, and its label would otherwise end up in the
      // diagram source (rendering a stray node labelled "复制").
      const code = pre.querySelector('code')
      const wrapper = document.createElement('figure')
      wrapper.className = 'mermaid-block'
      wrapper.dataset.source = (code?.textContent ?? pre.textContent ?? '').trim()
      pre.replaceWith(wrapper)
    }
  }

  /**
   * Read the palette that is actually in force.
   *
   * The four themes all set the same custom properties, and every one of the
   * two dark palettes sets `color-scheme: dark`. Reading both means a diagram
   * cannot fall out of step with the page — the earlier check only knew about
   * `data-theme="dark"` and painted light diagrams on a dark HSBC page.
   */
  const readPalette = () => {
    const root = getComputedStyle(document.documentElement)
    const value = (name: string) => root.getPropertyValue(name).trim()

    const dark = root.colorScheme.includes('dark')

    return {
      dark,
      paper: value('--paper') || '#e9e9e2',
      surface: value('--paper-2') || '#dfdfd6',
      ink: value('--ink') || '#161616',
      muted: value('--ink-3') || '#16161678',
      blue: value('--blue') || '#1f4fa8',
    }
  }

  const renderMermaid = async () => {
    upgradeBlocks()

    const wrappers = [...document.querySelectorAll<HTMLElement>('.mermaid-block')]
    if (!wrappers.length) return

    const palette = readPalette()

    // `base` with every variable spelled out is the only preset that does
    // not smuggle in its own rainbow; the diagram stays on paper, ink and
    // blueprint blue, square-cornered, with straight connectors.
    mermaid.initialize({
      startOnLoad: false,
      theme: 'base',
      flowchart: {
        curve: 'linear',
        htmlLabels: true,
        padding: 14,
        nodeSpacing: 34,
        rankSpacing: 44,
      },
      themeVariables: {
        darkMode: palette.dark,
        background: palette.surface,
        fontFamily:
          '-apple-system, BlinkMacSystemFont, PingFang SC, Noto Sans SC, Microsoft YaHei, sans-serif',
        fontSize: '13px',

        // Nodes: printed boxes on the sheet.
        primaryColor: palette.paper,
        primaryTextColor: palette.ink,
        primaryBorderColor: palette.ink,
        mainBkg: palette.paper,
        nodeBorder: palette.ink,
        nodeTextColor: palette.ink,
        secondaryColor: palette.surface,
        secondaryBorderColor: palette.muted,
        tertiaryColor: palette.surface,
        tertiaryBorderColor: palette.muted,

        // Connectors: the blueprint layer.
        lineColor: palette.blue,
        textColor: palette.ink,
        edgeLabelBackground: palette.surface,

        // Clusters and titles stay quiet.
        clusterBkg: palette.surface,
        clusterBorder: palette.muted,
        titleColor: palette.ink,
      },
      securityLevel: 'loose',
    })

    for (const wrapper of wrappers) {
      wrapper.innerHTML = ''
      const node = document.createElement('div')
      node.className = 'mermaid'
      node.textContent = wrapper.dataset.source ?? ''
      wrapper.append(node)
    }

    const nodes = wrappers
      .map((wrapper) => wrapper.querySelector('.mermaid'))
      .filter((node) => node instanceof HTMLElement)

    await mermaid.run({ nodes })
  }

  const safeRender = () => {
    renderMermaid().catch((error) => {
      console.error('Failed to render Mermaid diagrams.', error)
    })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', safeRender, { once: true })
  } else {
    safeRender()
  }

  document.addEventListener('astro:page-load', safeRender)

  // Re-render when the reader flips the theme
  document.addEventListener('themechange', safeRender)
</script>
