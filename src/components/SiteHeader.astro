---
import { getAllPosts } from '../lib/posts'
import { siteConfig } from '../data/site'

const currentPath = Astro.url.pathname

const navItems = [
  { href: '/archive', label: '归档', matches: ['/archive'] },
  { href: '/topics', label: '主题', matches: ['/topics/'] },
  { href: '/tags', label: '标签', matches: ['/tags/'] },
  { href: '/projects', label: '作品', matches: ['/projects'] },
  { href: '/about', label: '关于', matches: ['/about'] },
]

const isActive = (matches: string[], href: string) =>
  currentPath === href || matches.some((match) => currentPath === match || currentPath.startsWith(match))

// The dateline strip: today's date, ISO week, and whatever landed most recently.
const now = new Date()
const dateLabel = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  weekday: 'short',
}).format(now)

const isoWeek = (() => {
  const date = new Date(Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()))
  const day = date.getUTCDay() || 7
  date.setUTCDate(date.getUTCDate() + 4 - day)
  const yearStart = Date.UTC(date.getUTCFullYear(), 0, 1)
  return Math.ceil(((date.getTime() - yearStart) / 86400000 + 1) / 7)
})()

const allPosts = await getAllPosts()
const latest = allPosts[0]
---

<header class="mast">
  <div class="mast__inner wrap">
    <a class="mast__brand" href="/" aria-label="panbo.space — 首页">
      <span class="seal" aria-hidden="true">盘</span>
      <span class="mast__word">
        <b>panbo.space</b>
        <small>Panbo</small>
      </span>
    </a>

    <nav class="mast__nav" aria-label="主导航">
      {navItems.map((item) => (
        <a
          href={item.href}
          data-nav-link
          data-match={item.matches.join(',')}
          class:list={[isActive(item.matches, item.href) && 'is-active']}
          aria-current={isActive(item.matches, item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="mast__tools">
      <a class="icon-btn" href="/search" aria-label="搜索" title="搜索（⌘K）">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m21 21-4.35-4.35" />
        </svg>
      </a>

      <a class="icon-btn" href={siteConfig.social.github} aria-label="GitHub" title="GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
        </svg>
      </a>

      <button type="button" class="icon-btn" data-theme-toggle aria-label="切换明暗主题" title="切换明暗主题">
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.8 6.8 0 0 0 10.5 10.5Z" />
        </svg>
      </button>

      <a class="mast__cta" href="/rss.xml">订阅</a>

      <button
        type="button"
        class="icon-btn mast__menu"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="打开菜单"
      >
        <svg class="icon-menu" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg class="icon-close" viewBox="0 0 24 24" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18" />
        </svg>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" data-mobile-nav aria-label="移动端导航">
    {navItems.map((item) => (
      <a
        href={item.href}
        data-nav-link
        data-match={item.matches.join(',')}
        class:list={[isActive(item.matches, item.href) && 'is-active']}
        aria-current={isActive(item.matches, item.href) ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))}

    <!-- The utilities hidden from the narrow mast stay reachable here -->
    <div class="mobile-nav__tools">
      <a href="/search">搜索</a>
      <a href={siteConfig.social.github} target="_blank" rel="noreferrer">GitHub ↗</a>
      <a href="/rss.xml">订阅 RSS</a>
    </div>
  </nav>
</header>

<div class="dateline">
  <div class="dateline__inner wrap">
    <div class="dateline__left">
      <span>{dateLabel}</span>
      <span class="dateline__week">Week {isoWeek}</span>
    </div>
    {latest && (
      <span class="dateline__live">
        <i aria-hidden="true"></i>
        <a href={`/posts/${latest.data.slug}`}>最新 · {latest.data.title}</a>
      </span>
    )}
  </div>
</div>
