---
import { siteConfig } from '../data/site'

const currentPath = Astro.url.pathname
const navItems = [
  { href: '/archive', label: 'Archive', matches: ['/archive'] },
  { href: '/tags', label: 'Coverage', matches: ['/topics/', '/tags'] },
  { href: '/about', label: 'Profile', matches: ['/about'] },
]

const isActive = (matches: string[], href: string) =>
  currentPath === href || matches.some((match) => currentPath === match || currentPath.startsWith(match))
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/">
      <span class="site-header__brand-mark" aria-hidden="true"></span>
      <span class="site-header__brand-copy">
        <small>{siteConfig.hero.eyebrow}</small>
        <strong>panbo.space</strong>
      </span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      {navItems.map((item) => (
        <a
          href={item.href}
          data-nav-link
          data-match={item.matches.join(',')}
          class:list={[isActive(item.matches, item.href) && 'is-active']}
          aria-current={isActive(item.matches, item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="site-header__actions">
      <a
        class:list={['site-header__search', currentPath === '/search' && 'is-active']}
        href="/search"
        aria-label="打开搜索"
        data-nav-link
        data-match="/search"
        aria-current={currentPath === '/search' ? 'page' : undefined}
      >
        Search
        <span>⌘K</span>
      </a>

      <button class="site-header__utility site-header__theme-toggle" type="button" data-theme-toggle>
        <span data-theme-toggle-label>Light</span>
      </button>

      <a class="site-header__utility" href="/rss.xml">RSS</a>
    </div>
  </div>
</header>
