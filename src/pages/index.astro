---
import BaseLayout from '../layouts/BaseLayout.astro'
import { siteConfig } from '../data/site'
import { getAllPosts, getLatestPosts, getPostsByTrack, trackLabels } from '../lib/posts'

const allPosts = await getAllPosts()
const latestPosts = await getLatestPosts(6)
const allThinkingPosts = await getPostsByTrack('thinking')
const allWorkPosts = await getPostsByTrack('work')
const allEngineeringPosts = await getPostsByTrack('engineering')
const allGamesPosts = await getPostsByTrack('games')

const stats = [
  { label: 'Archive', value: allPosts.length, href: '/archive' },
  { label: 'Thinking', value: allThinkingPosts.length, href: '/archive?track=thinking' },
  { label: 'Work', value: allWorkPosts.length, href: '/archive?track=work' },
  { label: 'Games', value: allGamesPosts.length, href: '/archive?track=games' },
]

const tracks = [
  { name: 'Engineering', desc: '系统、架构与工程判断', count: allEngineeringPosts.length, href: '/archive?track=engineering' },
  { name: 'Thinking', desc: '职业判断、长期主义与个人系统', count: allThinkingPosts.length, href: '/archive?track=thinking' },
  { name: 'Work Notes', desc: '组织约束、项目推进与真实现场', count: allWorkPosts.length, href: '/archive?track=work' },
]

const topics = [
  { name: '架构心得', post: allEngineeringPosts[0]?.data.title, href: '/archive?track=engineering&topic=架构心得' },
  { name: 'Java', post: allEngineeringPosts.find(p => p.data.topic === 'Java')?.data.title, href: '/archive?track=engineering&topic=Java' },
  { name: '分布式系统', post: allEngineeringPosts.find(p => p.data.topic === '分布式系统')?.data.title, href: '/archive?track=engineering&topic=分布式系统' },
]
---

<BaseLayout mainClass="page-home">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero__inner">
      <p class="hero__eyebrow">{siteConfig.hero.eyebrow}</p>
      <h1 class="hero__title">{siteConfig.hero.title}</h1>
      <p class="hero__summary">{siteConfig.hero.summary}</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href={siteConfig.hero.primaryCta.href}>
          {siteConfig.hero.primaryCta.label}
        </a>
        <a class="btn btn--ghost" href={siteConfig.hero.secondaryCta.href}>
          {siteConfig.hero.secondaryCta.label}
        </a>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="stats">
    {stats.map((stat, index) => (
      <a
        class="stats__item"
        href={stat.href}
        style={`animation-delay: ${320 + index * 60}ms`}
      >
        <span class="stats__value">{stat.value}</span>
        <span class="stats__label">{stat.label}</span>
      </a>
    ))}
  </section>

  <!-- Latest Posts Section -->
  <section class="section">
    <div class="section__header">
      <h2 class="section__title">Latest</h2>
      <a class="section__link" href="/archive">View all →</a>
    </div>
    <div class="post-list">
      {latestPosts.map((post, index) => (
        <a
          class="post-item animate-on-scroll"
          href={`/posts/${post.data.slug}`}
          style={`animation-delay: ${index * 60}ms`}
        >
          <span class="post-item__date">
            {post.data.publishedAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
          </span>
          <div class="post-item__content">
            <span class="post-item__track">{trackLabels[post.data.track]}</span>
            <span class="post-item__title">{post.data.title}</span>
            <p class="post-item__summary">{post.data.summary}</p>
            <div class="post-item__meta">
              {post.data.topic && <span>{post.data.topic}</span>}
              <span>{Math.ceil((post.body ?? '').length / 1500)} min read</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Tracks Section -->
  <section class="section section--bordered">
    <div class="section__header">
      <h2 class="section__title">Tracks</h2>
      <a class="section__link" href="/archive">Browse →</a>
    </div>
    <div class="track-grid">
      {tracks.map((track, index) => (
        <a
          class="track-card animate-on-scroll"
          href={track.href}
          style={`animation-delay: ${index * 80}ms`}
        >
          <span class="track-card__name">{track.name}</span>
          <span class="track-card__desc">{track.desc}</span>
          <span class="track-card__count">{track.count} notes</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Topics Section -->
  {topics.some(t => t.post) && (
    <section class="section">
      <div class="section__header">
        <h2 class="section__title">Topics</h2>
      </div>
      <div class="topic-list">
        {topics.filter(t => t.post).map((topic, index) => (
          <a
            class="topic-item animate-on-scroll"
            href={topic.href}
            style={`animation-delay: ${index * 60}ms`}
          >
            <div class="topic-item__left">
              <span class="topic-item__name">{topic.name}</span>
              <span class="topic-item__post">{topic.post}</span>
            </div>
            <span class="topic-item__count">→</span>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>