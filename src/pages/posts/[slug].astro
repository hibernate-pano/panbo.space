---
import { render } from 'astro:content'
import MermaidRuntime from '../../components/MermaidRuntime.astro'
import TableOfContents from '../../components/TableOfContents.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { formatDate, getAllPosts, getReadingTime, toPostPath, trackLabels } from '../../lib/posts'
import { formatTagLabel, getPostTags, toTagPath } from '../../lib/post-tags'
import { toTopicSlug } from '../../lib/slug'

export const getStaticPaths = async () => {
  const posts = await getAllPosts()
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content, headings } = await render(post)
const readingTime = getReadingTime(post.body ?? '')
const ogImage = `/og/${post.data.slug}.svg`
const sectionCount = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3 && heading.text !== '目录').length
const hasToc = sectionCount >= 3
const tags = getPostTags(post)
const metaTags = [post.data.topic, ...tags].filter((value): value is string => Boolean(value))
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  image={ogImage}
  canonicalPath={toPostPath(post)}
  type="article"
  showProgress
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  tags={metaTags}
>
  <div class="post-page">
    <header class="post-header">
      <div class="post-header__meta">
        <span>{trackLabels[post.data.track]}</span>
        {post.data.topic && (
          <a href={`/topics/${toTopicSlug(post.data.topic)}`}>{post.data.topic}</a>
        )}
        <span>{formatDate(post.data.publishedAt)}</span>
      </div>

      <h1 class="post-header__title">{post.data.title}</h1>
      <p class="post-header__summary">{post.data.summary}</p>

      <div class="post-header__facts">
        <div class="post-header__fact">
          <span class="post-header__fact-label">Published</span>
          <span class="post-header__fact-value">{formatDate(post.data.publishedAt)}</span>
        </div>
        {post.data.updatedAt && (
          <div class="post-header__fact">
            <span class="post-header__fact-label">Updated</span>
            <span class="post-header__fact-value">{formatDate(post.data.updatedAt)}</span>
          </div>
        )}
        <div class="post-header__fact">
          <span class="post-header__fact-label">Read time</span>
          <span class="post-header__fact-value">{readingTime} min</span>
        </div>
      </div>
    </header>

    <div class:list={['post-layout', hasToc ? 'post-layout--with-toc' : '']}>
      <article class="post-content">
        <div class="prose">
          <Content />
        </div>

        {(post.data.topic || post.data.series || tags.length > 0) && (
          <footer class="post-taxonomy">
            <div class="post-taxonomy__chips">
              {post.data.topic && (
                <a href={`/topics/${toTopicSlug(post.data.topic)}`} class="tag">
                  {post.data.topic}
                </a>
              )}
              {post.data.series && <span class="tag">{post.data.series}</span>}
              {tags.map((tag) => (
                <a href={toTagPath(tag)} class="tag">
                  {formatTagLabel(tag)}
                </a>
              ))}
            </div>
          </footer>
        )}
      </article>

      {hasToc && (
        <aside class="post-sidebar">
          <div class="sidebar-section">
            <p class="sidebar-section__title">On this page</p>
            <TableOfContents headings={headings} />
          </div>
        </aside>
      )}
    </div>
  </div>

  <MermaidRuntime />
</BaseLayout>

<style>
  .post-layout--with-toc {
    display: grid;
    grid-template-columns: minmax(0, var(--reading-width)) 240px;
    gap: var(--space-8);
    align-items: start;
  }

  .post-taxonomy {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .post-taxonomy__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (max-width: 1024px) {
    .post-layout--with-toc {
      grid-template-columns: 1fr;
    }

    .post-sidebar {
      position: static;
      display: block;
      border-top: 1px solid var(--color-border);
      padding-top: var(--space-5);
      max-height: none;
    }
  }
</style>
