---
import BaseLayout from '../layouts/BaseLayout.astro'
import { siteConfig } from '../data/site'
import { getProjectStats } from '../data/projects'
import {
  formatDate,
  getAllPosts,
  getLatestPosts,
  getReadingTime,
  getTopicMap,
  toPostPath,
  trackLabels,
  type TrackKey,
} from '../lib/posts'

const allPosts = await getAllPosts()
const latestPosts = await getLatestPosts(9)
const topicMap = await getTopicMap()
const projectStats = getProjectStats()

const countByTrack = (key: TrackKey) => allPosts.filter((post) => post.data.track === key).length

const trackMeta: Record<string, { desc: string }> = {
  thinking: { desc: '职业判断、长期主义与个人系统' },
  work: { desc: '组织约束、项目推进与真实现场' },
  philosophy: { desc: '哲学思辨、存在与意义的长期阅读' },
  psychology: { desc: '人格、潜意识与心灵的现代解读' },
  engineering: { desc: '系统、架构与工程判断' },
  games: { desc: '玩过的游戏与做过的设计' },
}

// Only surface tracks that actually have notes — no empty shells
const tracks = (['thinking', 'work', 'philosophy', 'psychology', 'engineering', 'games'] as TrackKey[])
  .map((key) => ({ key, label: trackLabels[key], count: countByTrack(key), ...trackMeta[key] }))
  .filter((track) => track.count > 0 && track.desc)

const topics = [...topicMap.entries()]
  .sort((left, right) => right[1].length - left[1].length)
  .slice(0, 6)
  .map(([topic, posts]) => ({
    name: topic,
    post: posts[0]?.data.title ?? '',
    href: `/archive?topic=${encodeURIComponent(topic)}`,
  }))

// Hero ledger: total notes, then the two heaviest tracks
const ledger = [
  { label: '篇笔记', value: allPosts.length, href: '/archive' },
  ...[...tracks]
    .sort((a, b) => b.count - a.count)
    .slice(0, 2)
    .map((track) => ({
      label: track.label,
      value: track.count,
      href: `/archive?track=${track.key}`,
    })),
]

// The three-column contents: tracks, topics, and the site's own index
const columns = [
  {
    head: '栏目',
    link: { label: '按栏目归档 →', href: '/archive' },
    items: tracks.map((track) => ({
      meta: `${track.count} 篇`,
      title: track.label,
      sub: track.desc,
      href: `/archive?track=${track.key}`,
    })),
  },
  {
    head: '主题',
    link: { label: '全部主题 →', href: '/topics' },
    items: topics.map((topic) => ({
      meta: '',
      title: topic.name,
      sub: topic.post,
      href: topic.href,
    })),
  },
  {
    head: '索引',
    link: { label: '标签档案 →', href: '/tags' },
    items: [
      { meta: `${allPosts.length} 篇`, title: '全部归档', sub: '按年份与栏目排列', href: '/archive' },
      { meta: '索引', title: '标签档案', sub: '跨主题的横向索引', href: '/tags' },
      { meta: '作品', title: '在研项目', sub: `${projectStats.total} 个在做的产品`, href: '/projects' },
      { meta: '全文', title: '搜索', sub: '按关键词检索', href: '/search' },
    ],
  },
]
---

<BaseLayout>
  <section class="hero wrap">
    <p class="hero__kicker kicker">{siteConfig.hero.kicker}</p>

    <h1 class="hero__title">
      {siteConfig.hero.titleLines.map((line) => (
        <span class="hero__line">
          <span>
            {line.split(siteConfig.hero.accent).map((chunk, index) =>
              index === 1 ? (
                <>
                  <span class="r">{siteConfig.hero.accent}</span>
                  {chunk}
                </>
              ) : (
                chunk
              )
            )}
          </span>
        </span>
      ))}
    </h1>

    <div class="hero__foot">
      <div>
        <p class="hero__bio">{siteConfig.hero.summary}</p>
        <div class="hero__cta">
          <a class="btn btn--primary" href={siteConfig.hero.primaryCta.href}>
            {siteConfig.hero.primaryCta.label}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a class="btn btn--ghost" href={siteConfig.hero.secondaryCta.href}>
            {siteConfig.hero.secondaryCta.label}
          </a>
        </div>
      </div>

      <ul class="proof">
        {ledger.map((item) => (
          <li>
            <a href={item.href}>
              <b>{item.value}</b>
              <span>{item.label}</span>
              <i aria-hidden="true">↗</i>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec wrap">
    <header class="sec__head">
      <div>
        <p class="eyebrow">Contents · 本期目录</p>
        <h2 class="sec__title">这个档案里有什么。</h2>
      </div>
    </header>

    <div class="cols">
      {columns.map((column) => (
        <div>
          <div class="col__head">
            <b>{column.head}</b>
            <a href={column.link.href}>{column.link.label}</a>
          </div>
          <ul class="col__list">
            {column.items.map((item) => (
              <li>
                <a class="col__item" href={item.href}>
                  <span class="col__title">
                    {item.title}
                    {item.meta && <span class="col__count">{item.meta}</span>}
                  </span>
                  <span class="col__sub">{item.sub}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="band">
    <div class="band__inner wrap">
      <div>
        <p class="band__label">Projects · 在研作品</p>
        <h2 class="band__title">我做的，<br />和我正在做的。</h2>
      </div>
      <div>
        <p class="band__text">
          除了写字，我还在写代码。Chrome 扩展、Web 应用、Mac 应用和一个 iOS 应用——
          都是自己在真实工作里被逼出来，然后自己用上的东西。
        </p>
        <ul class="band__list">
          {tracks.slice(0, 3).map((track) => (
            <li>
              <a class="band__row" href={`/archive?track=${track.key}`}>
                <b>{track.label}</b>
                <span>{track.count} 篇</span>
                <i aria-hidden="true">↗</i>
              </a>
            </li>
          ))}
          <li>
            <a class="band__row" href="/projects">
              <b>全部作品与更新日志</b>
              <span>{projectStats.total} 个项目</span>
              <i aria-hidden="true">↗</i>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="sec wrap">
    <header class="sec__head">
      <div>
        <p class="eyebrow">Notes · 最新笔记</p>
        <h2 class="sec__title">最近写下的。</h2>
      </div>
      <a class="sec__link" href="/archive">全部归档 →</a>
    </header>

    <div>
      {latestPosts.map((post) => (
        <article class="post-card">
          <span class="post-card__date">{formatDate(post.data.publishedAt)}</span>
          <div class="post-card__main">
            <a href={toPostPath(post)}>
              <h3 class="post-card__title">{post.data.title}</h3>
              <p class="post-card__summary">{post.data.summary}</p>
            </a>
            <div class="post-card__footer">
              <span class="tag">{trackLabels[post.data.track]}</span>
              {post.data.topic && <span class="tag tag--accent">{post.data.topic}</span>}
              <span class="post-card__readmore">{getReadingTime(post.body ?? '')} 分钟</span>
            </div>
          </div>
          <a class="post-card__arrow" href={toPostPath(post)} aria-label={post.data.title}>
            →
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
