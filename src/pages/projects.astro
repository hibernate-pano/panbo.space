---
import BaseLayout from '../layouts/BaseLayout.astro'
import { siteConfig } from '../data/site'
import { getSortedProjects, getProjectStats } from '../data/projects'
import { formatDate } from '../lib/posts'

const projects = getSortedProjects()
const stats = getProjectStats()

const kindOrder = ['chrome-extension', 'web-app', 'mac-app'] as const
const kindSectionLabels: Record<(typeof kindOrder)[number], string> = {
  'chrome-extension': 'Chrome 扩展',
  'web-app': 'Web 应用',
  'mac-app': 'Mac 应用',
}

const sectionedProjects = kindOrder
  .map((kind) => ({
    kind,
    label: kindSectionLabels[kind],
    projects: projects.filter((project) => project.kind === kind),
  }))
  .filter((section) => section.projects.length > 0)
---

<BaseLayout
  title="Projects"
  description="Panbo 的在研作品清单：Chrome 扩展、Web 应用与 Mac 应用，附最近更新日志与报告链接。"
>
  <div class="projects-page">
    <header class="projects-header">
      <p class="page-header__eyebrow">Projects</p>
      <h1 class="projects-header__title">在研作品</h1>
      <p class="projects-header__intro">
        {stats.total} 个在研项目，{stats.public} 个开源在 GitHub，{stats.live} 个有公网地址。这里记录代码工作的最近动态，与文章互为补充。
      </p>
    </header>
    <p class="projects-updated-note">
      更新时间以各项目仓库最新提交为准 · 最近一次 {formatDate(new Date(projects[0]!.updatedAt))} ·
      <a href={siteConfig.social.github} target="_blank" rel="noreferrer">GitHub 主页</a>
    </p>

    {sectionedProjects.map((section) => (
      <section class="projects-section">
        <h2 class="projects-section__title">{section.label}</h2>
        <div class="projects-grid">
          {section.projects.map((project) => (
            <article class="project-card" id={project.name}>
              <header class="project-card__header">
                <h3 class="project-card__name">{project.name}</h3>
                <span class="project-card__status">{project.status}</span>
              </header>
              <p class="project-card__tagline">{project.tagline}</p>
              <div class="project-card__links">
                {project.repoUrl && (
                  <a class="project-card__link" href={project.repoUrl} target="_blank" rel="noreferrer">
                    GitHub ↗
                  </a>
                )}
                {project.privateRepo && (
                  <span class="project-card__badge project-card__badge--private">私有仓库</span>
                )}
                {project.liveUrl && (
                  <a class="project-card__link" href={project.liveUrl} target="_blank" rel="noreferrer">
                    Live ↗
                  </a>
                )}
                {project.report && (
                  <a class="project-card__link" href={project.report.href} target="_blank" rel="noreferrer">
                    {project.report.label} ↗
                  </a>
                )}
              </div>
              <div class="project-card__meta">
                <span>最近更新 {formatDate(new Date(project.updatedAt))}</span>
                {project.stack.map((tech) => (
                  <span class="project-card__tech">{tech}</span>
                ))}
              </div>
              <div class="project-card__updates">
                <h4 class="project-card__updates-title">Update log</h4>
                <ol class="project-updates">
                  {project.updates.map((update) => (
                    <li class="project-update">
                      <span class="project-update__date">{update.date}</span>
                      <span class="project-update__summary">{update.summary}</span>
                      {update.report && (
                        <a class="project-update__report" href={update.report.href} target="_blank" rel="noreferrer">
                          {update.report.label} ↗
                        </a>
                      )}
                    </li>
                  ))}
                </ol>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>


