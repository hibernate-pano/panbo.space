---
import BaseLayout from '../layouts/BaseLayout.astro'
import { siteConfig } from '../data/site'
import { getSortedProjects, getProjectStats } from '../data/projects'
import { formatDate } from '../lib/posts'

const projects = getSortedProjects()
const stats = getProjectStats()

const kindOrder = ['chrome-extension', 'web-app', 'mac-app'] as const
const kindSectionLabels: Record<(typeof kindOrder)[number], string> = {
  'chrome-extension': 'Chrome 扩展',
  'web-app': 'Web 应用',
  'mac-app': 'Mac 应用',
}

const sectionedProjects = kindOrder
  .map((kind) => ({
    kind,
    label: kindSectionLabels[kind],
    projects: projects.filter((project) => project.kind === kind),
  }))
  .filter((section) => section.projects.length > 0)
---

<BaseLayout
  title="Projects"
  description="Panbo 的在研作品清单：Chrome 扩展、Web 应用与 Mac 应用，附最近更新日志与报告链接。"
>
  <div class="projects-page">
    <header class="projects-header">
      <p class="hero__eyebrow">Projects</p>
      <h1 class="projects-header__title">在研作品</h1>
      <p class="projects-header__intro">
        {stats.total} 个在研项目，{stats.public} 个开源在 GitHub，{stats.live} 个有公网地址。这里记录代码工作的最近动态，与文章互为补充。
      </p>
    </header>
    <p class="projects-updated-note">
      更新时间以各项目仓库最新提交为准 · 最近一次 {formatDate(new Date(projects[0]!.updatedAt))} ·
      <a href={siteConfig.social.github} target="_blank" rel="noreferrer">GitHub 主页</a>
    </p>

    {sectionedProjects.map((section) => (
      <section class="projects-section">
        <h2 class="projects-section__title">{section.label}</h2>
        <div class="projects-grid">
          {section.projects.map((project) => (
            <article class="project-card" id={project.name}>
              <header class="project-card__header">
                <h3 class="project-card__name">{project.name}</h3>
                <span class="project-card__status">{project.status}</span>
              </header>
              <p class="project-card__tagline">{project.tagline}</p>
              <div class="project-card__links">
                {project.repoUrl && (
                  <a class="project-card__link" href={project.repoUrl} target="_blank" rel="noreferrer">
                    GitHub ↗
                  </a>
                )}
                {project.privateRepo && (
                  <span class="project-card__badge project-card__badge--private">私有仓库</span>
                )}
                {project.liveUrl && (
                  <a class="project-card__link" href={project.liveUrl} target="_blank" rel="noreferrer">
                    Live ↗
                  </a>
                )}
                {project.report && (
                  <a class="project-card__link" href={project.report.href} target="_blank" rel="noreferrer">
                    {project.report.label} ↗
                  </a>
                )}
              </div>
              <div class="project-card__meta">
                <span>最近更新 {formatDate(new Date(project.updatedAt))}</span>
                {project.stack.map((tech) => (
                  <span class="project-card__tech">{tech}</span>
                ))}
              </div>
              <div class="project-card__updates">
                <h4 class="project-card__updates-title">Update log</h4>
                <ol class="project-updates">
                  {project.updates.map((update) => (
                    <li class="project-update">
                      <span class="project-update__date">{update.date}</span>
                      <span class="project-update__summary">{update.summary}</span>
                      {update.report && (
                        <a class="project-update__report" href={update.report.href} target="_blank" rel="noreferrer">
                          {update.report.label} ↗
                        </a>
                      )}
                    </li>
                  ))}
                </ol>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .projects-page {
    padding: var(--space-8) 0;
    max-width: var(--reading-width);
  }

  .projects-header {
    border-left: 3px solid var(--color-accent);
    padding-left: 20px;
  }
  .projects-header .hero__eyebrow {
    margin: 0 0 8px;
  }
  .projects-header__title {
    margin: 0 0 10px;
    font-size: 34px;
  }
  .projects-header__intro {
    margin: 0;
    color: var(--color-text-muted);
  }
  .projects-updated-note {
    color: var(--color-text-faint);
    font-size: 13px;
    margin: 16px 0 40px;
  }
  .projects-updated-note a {
    color: var(--color-accent);
  }

  .projects-section {
    margin-bottom: 48px;
  }
  .projects-section__title {
    font-size: 22px;
    margin: 0 0 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--color-border);
  }
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  .project-card {
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 24px;
    margin-bottom: 20px;
  }
  .project-card__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .project-card__name {
    margin: 0;
    font-size: 20px;
    font-family: var(--font-mono);
  }
  .project-card__status {
    font-size: 12px;
    color: var(--color-green-ink);
    background: rgba(97, 255, 131, 0.08);
    border: 1px solid rgba(97, 255, 131, 0.25);
    border-radius: 999px;
    padding: 3px 10px;
    white-space: nowrap;
  }
  .project-card__tagline {
    color: var(--color-text);
    margin: 10px 0 14px;
  }
  .project-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .project-card__link {
    font-size: 13px;
    color: var(--color-accent);
    text-decoration: none;
    border: 1px solid var(--color-border-hover);
    border-radius: 6px;
    padding: 4px 10px;
  }
  .project-card__link:hover {
    background: rgba(97, 255, 131, 0.08);
    border-color: var(--color-accent);
  }
  .project-card__badge--private {
    font-size: 12px;
    color: var(--color-text-faint);
    border: 1px dashed var(--color-border-hover);
    border-radius: 6px;
    padding: 3px 10px;
  }
  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin: 14px 0 0;
    font-size: 12px;
    color: var(--color-text-faint);
  }
  .project-card__tech {
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 1px 8px;
  }
  .project-card__updates {
    margin-top: 16px;
    border-top: 1px dashed var(--color-border);
    padding-top: 12px;
  }
  .project-card__updates-title {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-faint);
    margin: 0 0 8px;
  }
  .project-updates {
    margin: 0;
    padding-left: 18px;
  }
  .project-update {
    margin-bottom: 6px;
    color: var(--color-text-muted);
    font-size: 14px;
    line-height: 1.7;
  }
  .project-update__date {
    font-family: var(--font-mono);
    color: var(--color-accent-soft);
    margin-right: 8px;
  }
  .project-update__report {
    color: var(--color-accent);
    font-size: 13px;
    margin-left: 8px;
  }
  @media (max-width: 640px) {
    .projects-page {
      padding: var(--space-6) 0;
    }
    .project-card {
      padding: 18px;
    }
  }
</style>
