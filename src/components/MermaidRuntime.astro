<script>
  import mermaid from 'mermaid'

  const upgradeBlocks = () => {
    const blocks = document.querySelectorAll('pre[data-language="mermaid"], pre > code.language-mermaid')

    for (const block of blocks) {
      const pre = block instanceof HTMLElement && block.matches('pre') ? block : block.closest('pre')
      if (!pre) continue

      const wrapper = document.createElement('figure')
      wrapper.className = 'mermaid-block'
      wrapper.dataset.source = (pre.textContent ?? '').trim()
      pre.replaceWith(wrapper)
    }
  }

  const renderMermaid = async () => {
    upgradeBlocks()

    const wrappers = [...document.querySelectorAll<HTMLElement>('.mermaid-block')]
    if (!wrappers.length) return

    const isDark =
      document.documentElement.dataset.theme === 'dark' ||
      (!document.documentElement.dataset.theme &&
        window.matchMedia('(prefers-color-scheme: dark)').matches)

    mermaid.initialize({
      startOnLoad: false,
      theme: isDark ? 'dark' : 'neutral',
      // Match the site's paper-and-ink neutrals instead of Mermaid's default blue-grey
      themeVariables: isDark
        ? {
            background: '#14120f',
            primaryColor: '#1c1a16',
            primaryTextColor: '#ece5d6',
            primaryBorderColor: '#3a362e',
            lineColor: '#8a8272',
            secondaryColor: '#26231d',
            tertiaryColor: '#1c1a16',
            fontFamily: '-apple-system, PingFang SC, Microsoft YaHei, sans-serif',
          }
        : {
            background: '#f8f6f1',
            primaryColor: '#efece4',
            primaryTextColor: '#1f1e1b',
            primaryBorderColor: '#d5cfbf',
            lineColor: '#6d6a62',
            secondaryColor: '#f8f6f1',
            tertiaryColor: '#efece4',
            fontFamily: '-apple-system, PingFang SC, Microsoft YaHei, sans-serif',
          },
      securityLevel: 'loose',
    })

    for (const wrapper of wrappers) {
      wrapper.innerHTML = ''
      const node = document.createElement('div')
      node.className = 'mermaid'
      node.textContent = wrapper.dataset.source ?? ''
      wrapper.append(node)
    }

    const nodes = wrappers
      .map((wrapper) => wrapper.querySelector('.mermaid'))
      .filter((node) => node instanceof HTMLElement)

    await mermaid.run({ nodes })
  }

  const safeRender = () => {
    renderMermaid().catch((error) => {
      console.error('Failed to render Mermaid diagrams.', error)
    })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', safeRender, { once: true })
  } else {
    safeRender()
  }

  document.addEventListener('astro:page-load', safeRender)

  // Re-render when the reader flips the theme
  document.addEventListener('themechange', safeRender)
</script>
