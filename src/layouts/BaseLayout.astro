---
import '@fontsource-variable/newsreader/wght.css'
import '@fontsource-variable/newsreader/wght-italic.css'
import '@fontsource-variable/inter/wght.css'
import '@fontsource/ibm-plex-mono/latin-400.css'
import '@fontsource/ibm-plex-mono/latin-500.css'
import '../styles/global.css'
import { siteConfig } from '../data/site'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'

type Props = {
  title?: string
  description?: string
  image?: string
  canonicalPath?: string
  type?: 'website' | 'article'
  showProgress?: boolean
  publishedAt?: Date
  updatedAt?: Date
  tags?: string[]
  mainClass?: string
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = '/og/home.svg',
  canonicalPath = Astro.url.pathname,
  type = 'website',
  showProgress = false,
  publishedAt,
  updatedAt,
  tags = [],
  mainClass,
} = Astro.props as Props

const pageTitle = title === siteConfig.title ? siteConfig.title : `${title} · ${siteConfig.title}`
const canonicalUrl = new URL(canonicalPath, siteConfig.site).toString()
const imageUrl = image.startsWith('http') ? image : new URL(image, siteConfig.site).toString()

// Runs before first paint so a dark-mode reader never sees a white flash.
const themeBoot = `
  (() => {
    try {
      const stored = localStorage.getItem('theme');
      const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const resolved = stored === 'light' || stored === 'dark' ? stored : (dark ? 'dark' : 'light');
      document.documentElement.dataset.theme = resolved;
    } catch {}
  })();
`

const runtimeScript = `
  (() => {
    let tocObserver;

    const syncProgress = () => {
      const progress = document.querySelector('[data-reading-progress]');
      if (!progress) return;
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = scrollable > 0 ? Math.min(window.scrollY / scrollable, 1) : 0;
      progress.style.transform = 'scaleX(' + ratio + ')';
    };

    const syncHeaderState = () => {
      const header = document.querySelector('.site-header');
      if (!header) return;
      header.classList.toggle('site-header--scrolled', window.scrollY > 8);
    };

    const syncActiveNav = () => {
      const pathname = window.location.pathname;
      document.querySelectorAll('[data-nav-link]').forEach((link) => {
        const href = link.getAttribute('href') || '/';
        const matches = (link.getAttribute('data-match') || href)
          .split(',')
          .map((value) => value.trim())
          .filter(Boolean);
        const active = pathname === href || matches.some((match) => pathname === match || (match !== '/' && pathname.startsWith(match)));
        link.classList.toggle('is-active', active);
        link.setAttribute('aria-current', active ? 'page' : 'false');
      });
    };

    const setupThemeToggle = () => {
      const toggle = document.querySelector('[data-theme-toggle]');
      if (!toggle || toggle.dataset.ready === 'true') return;
      toggle.dataset.ready = 'true';

      toggle.addEventListener('click', () => {
        const current = document.documentElement.dataset.theme
          || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';

        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
        document.dispatchEvent(new CustomEvent('themechange', { detail: { theme: next } }));
      });
    };

    const setupMobileNav = () => {
      const toggle = document.querySelector('[data-menu-toggle]');
      const nav = document.querySelector('[data-mobile-nav]');
      if (!toggle || !nav || toggle.dataset.ready === 'true') return;
      toggle.dataset.ready = 'true';

      const setOpen = (open) => {
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
        nav.classList.toggle('is-open', open);
      };

      toggle.addEventListener('click', () => {
        setOpen(toggle.getAttribute('aria-expanded') !== 'true');
      });

      nav.addEventListener('click', (event) => {
        if (event.target.closest('a')) setOpen(false);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setOpen(false);
      });

      // Leaving mobile width should not leave the sheet stuck open
      window.matchMedia('(min-width: 821px)').addEventListener('change', (event) => {
        if (event.matches) setOpen(false);
      });
    };

    const setupToc = () => {
      tocObserver?.disconnect();

      const links = [...document.querySelectorAll('[data-toc-link]')];
      const headings = links
        .map((link) => document.getElementById(link.getAttribute('data-toc-link') || ''))
        .filter((heading) => heading instanceof HTMLElement);

      if (!links.length || !headings.length) return;

      const updateActiveHeading = () => {
        const currentHeading = [...headings].reverse().find((heading) => heading.getBoundingClientRect().top <= 140) || headings[0];

        links.forEach((link) => {
          link.classList.toggle('is-active', link.getAttribute('data-toc-link') === currentHeading.id);
        });
      };

      tocObserver = new IntersectionObserver(updateActiveHeading, {
        rootMargin: '-100px 0px -70% 0px',
        threshold: [0, 1],
      });

      headings.forEach((heading) => tocObserver.observe(heading));
      updateActiveHeading();
    };

    const focusSearchInput = () => {
      document.querySelector('[data-search-input]')?.focus();
    };

    const isEditableTarget = (event) => {
      const target = event.target;
      return (
        target instanceof HTMLElement &&
        (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName))
      );
    };

    const handleKeydown = (event) => {
      if (!(event.metaKey || event.ctrlKey) || event.key.toLowerCase() !== 'k') return;
      if (isEditableTarget(event) && window.location.pathname !== '/search') return;

      event.preventDefault();
      if (window.location.pathname === '/search') {
        focusSearchInput();
        return;
      }

      window.location.href = '/search';
    };

    const setupCodeCopy = () => {
      document.querySelectorAll('.prose pre').forEach((pre) => {
        if (pre.dataset.copyReady) return
        pre.dataset.copyReady = 'true'

        const code = pre.querySelector('code')
        if (!code) return

        const button = document.createElement('button')
        button.type = 'button'
        button.className = 'code-copy'
        button.textContent = '复制'
        button.setAttribute('aria-label', 'Copy code to clipboard')
        pre.append(button)

        button.addEventListener('click', async () => {
          const text = code.innerText
          let ok = false

          try {
            await navigator.clipboard.writeText(text)
            ok = true
          } catch {
            const textarea = document.createElement('textarea')
            textarea.value = text
            textarea.style.position = 'fixed'
            textarea.style.opacity = '0'
            document.body.append(textarea)
            textarea.select()
            try {
              ok = document.execCommand('copy')
            } catch {
              ok = false
            }
            textarea.remove()
          }

          button.textContent = ok ? '已复制' : '复制'
          button.classList.toggle('is-copied', ok)
          window.setTimeout(() => {
            button.textContent = '复制'
            button.classList.remove('is-copied')
          }, 1500)
        })
      })
    };

    const setupScrollAnimations = () => {
      const elements = document.querySelectorAll('.animate-on-scroll');
      if (!elements.length) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );

      elements.forEach((el) => observer.observe(el));
    };

    const initPage = () => {
      syncProgress();
      syncHeaderState();
      syncActiveNav();
      setupThemeToggle();
      setupMobileNav();
      setupToc();
      setupScrollAnimations();
      setupCodeCopy();
    };

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(() => {
        syncProgress();
        syncHeaderState();
        ticking = false;
      });
    }, { passive: true });

    window.addEventListener('resize', () => {
      syncProgress();
      setupToc();
    });

    window.addEventListener('keydown', handleKeydown);

    document.addEventListener('astro:page-load', initPage);

    initPage();
  })();
`
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author.name} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:creator" content="@HibernatePano" />
    <meta name="theme-color" content="#faf9f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1f1e1d" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-dark.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)" />
    {tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    {type === 'article' &&
      tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script is:inline set:html={themeBoot} />
  </head>
  <body>
    {showProgress && (
      <div class="reading-progress">
        <div class="reading-progress__bar" data-reading-progress></div>
      </div>
    )}

    <a href="#main" class="skip-link">跳到正文</a>

    <div class="site-shell">
      <SiteHeader />
      <main id="main" class:list={['site-main', mainClass]} data-pagefind-body>
        <slot />
      </main>
      <SiteFooter />
    </div>

    <script is:inline set:html={runtimeScript}></script>
  </body>
</html>
