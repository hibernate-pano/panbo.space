<section class="search-page" data-search-shell>
  <header class="search-header">
    <h1 class="search-header__title">Search</h1>
    <p class="search-header__summary">
      Search across the archive by title, topic, tag, or phrase.
    </p>
  </header>

  <div class="search-form">
    <input
      class="search-input"
      type="search"
      placeholder="Search notes..."
      autocomplete="off"
      data-search-input
    />
    <p class="search-hint">Press <kbd>⌘K</kbd> anytime to focus</p>
  </div>

  <p class="search-status" data-search-status aria-live="polite">Enter at least 1 keyword to search.</p>

  <div class="search-results" data-search-results></div>
</section>

<script type="module" is:inline>
  const shell = document.querySelector('[data-search-shell]')

  if (shell && shell.dataset.ready !== 'true') {
    shell.dataset.ready = 'true'

    const input = shell.querySelector('[data-search-input]')
    const status = shell.querySelector('[data-search-status]')
    const results = shell.querySelector('[data-search-results]')
    const params = new URLSearchParams(window.location.search)
    const MAX_RESULTS = 10
    let pagefindModule
    let pagefindPromise
    let debounceId
    let searchToken = 0

    const escapeHtml = (value) =>
      value
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;')

    const loadPagefind = async ({ silent = false } = {}) => {
      if (pagefindModule) return pagefindModule
      if (pagefindPromise) return pagefindPromise

      pagefindPromise = import('/pagefind/pagefind.js')
        .then((module) => {
          pagefindModule = module
          return module
        })
        .catch((error) => {
          pagefindPromise = undefined
          if (!silent) {
            status.textContent = 'Search index will be available after build.'
          }
          throw error
        })

      try {
        return await pagefindPromise
      } catch {
        return null
      }
    }

    const renderEmpty = (message) => {
      status.textContent = message
      results.innerHTML = ''
    }

    const preloadPagefind = () => {
      const warm = () => {
        loadPagefind({ silent: true }).catch(() => {})
      }

      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(warm, { timeout: 1200 })
      } else {
        window.setTimeout(warm, 250)
      }
    }

    const runSearch = async () => {
      const currentToken = ++searchToken
      const query = input.value.trim()
      const nextParams = new URLSearchParams(window.location.search)

      if (query) {
        nextParams.set('q', query)
      } else {
        nextParams.delete('q')
      }

      history.replaceState({}, '', nextParams.toString() ? `?${nextParams.toString()}` : window.location.pathname)

      if (!query) {
        renderEmpty('Enter at least 1 keyword to search.')
        return
      }

      status.textContent = pagefindModule ? 'Searching...' : 'Loading search index...'
      const api = await loadPagefind()
      if (!api || currentToken !== searchToken) return

      status.textContent = 'Processing results...'
      const search = await api.search(query)
      if (currentToken !== searchToken) return

      if (!search.results.length) {
        renderEmpty('No results found.')
        return
      }

      const data = await Promise.all(search.results.slice(0, MAX_RESULTS).map((result) => result.data()))
      if (currentToken !== searchToken) return

      status.textContent =
        search.results.length > data.length
          ? `Found ${search.results.length} results, showing first ${data.length}.`
          : `Found ${data.length} results.`
      results.innerHTML = data
        .map(
          (item) => `
            <article class="search-result">
              <a href="${item.url}" class="search-result__link">
                <h2 class="search-result__title">${escapeHtml(item.meta?.title || item.url)}</h2>
                <p class="search-result__excerpt">${item.excerpt}</p>
                <div class="search-result__meta">
                  <span>${escapeHtml(item.url)}</span>
                </div>
              </a>
            </article>
          `,
        )
        .join('')
    }

    const scheduleSearch = () => {
      window.clearTimeout(debounceId)
      debounceId = window.setTimeout(() => {
        runSearch().catch((error) => {
          console.error('Search failed.', error)
          status.textContent = 'Search failed. Please try again.'
        })
      }, 120)
    }

    input.value = params.get('q') ?? ''
    preloadPagefind()

    input.addEventListener('input', scheduleSearch)
    input.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter') return
      const firstResult = results.querySelector('.search-result__link')
      if (!(firstResult instanceof HTMLAnchorElement)) return
      event.preventDefault()
      window.location.href = firstResult.href
    })

    window.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault()
        input.focus()
      }
    })

    if (!window.matchMedia('(pointer: coarse)').matches) {
      requestAnimationFrame(() => input.focus())
    }

    if (input.value) {
      runSearch().catch((error) => {
        console.error('Search failed.', error)
      })
    }
  }
</script>

<style>
  .search-page {
    padding: var(--space-8) 0 var(--space-9);
    max-width: var(--reading-width);
  }

  .search-header {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .search-header__title {
    font-size: clamp(2.25rem, 4vw, 3rem);
    font-weight: 600;
    margin-bottom: var(--space-4);
  }

  .search-header__summary {
    max-width: 54ch;
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .search-form {
    max-width: 640px;
    margin-bottom: var(--space-5);
  }

  .search-input {
    width: 100%;
    height: 58px;
    padding: 0 var(--space-5);
    font-family: var(--font-body);
    font-size: 1.08rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-elevated) 72%, transparent);
    color: var(--color-text);
    transition: all var(--duration-fast);
  }

  .search-input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-subtle);
  }

  .search-input::placeholder {
    color: var(--color-text-muted);
  }

  .search-hint {
    margin-top: var(--space-3);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .search-hint kbd {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 2px 6px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: color-mix(in srgb, var(--color-elevated) 78%, transparent);
  }

  .search-status {
    margin: var(--space-5) 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .search-results {
    display: flex;
    flex-direction: column;
  }

  .search-result {
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--color-border);
    transition: border-color var(--duration-fast), transform var(--duration-fast);
  }

  .search-result:hover {
    border-color: var(--color-border-hover);
    transform: translateX(4px);
  }

  .search-result:last-child {
    border-bottom: none;
  }

  .search-result__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    text-decoration: none;
  }

  .search-result__title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text);
    transition: color var(--duration-fast);
  }

  .search-result__link:hover .search-result__title {
    color: var(--color-accent);
  }

  .search-result__excerpt {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  .search-result__excerpt mark {
    color: var(--color-text);
    background: var(--color-accent-subtle);
    border-radius: 3px;
    padding: 0 0.18em;
  }

  .search-result__meta {
    display: flex;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-top: var(--space-2);
  }
</style>
