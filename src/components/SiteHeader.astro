---
const currentPath = Astro.url.pathname

const navItems = [
  { href: '/archive', label: 'Archive', matches: ['/archive'] },
  { href: '/tags', label: 'Index', matches: ['/topics/', '/tags'] },
  { href: '/about', label: 'About', matches: ['/about'] },
]

const isActive = (matches: string[], href: string) =>
  currentPath === href || matches.some((match) => currentPath === match || currentPath.startsWith(match))
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/">
      <span class="site-header__brand-mark" aria-hidden="true"></span>
      <span class="site-header__brand-name">panbo.space</span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      {navItems.map((item) => (
        <a
          href={item.href}
          data-nav-link
          data-match={item.matches.join(',')}
          class:list={[isActive(item.matches, item.href) && 'is-active']}
          aria-current={isActive(item.matches, item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="site-header__actions">
      <a
        class="site-header__action"
        href="/search"
        aria-label="Search"
        data-nav-link
        data-match="/search"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
        <kbd>⌘K</kbd>
      </a>

      <div class="theme-selector" data-theme-selector>
        <button
          class="theme-selector__trigger"
          type="button"
          data-theme-toggle
          aria-label="Select theme"
          aria-haspopup="true"
          aria-expanded="false"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"/>
            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
          </svg>
          <svg class="theme-selector__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>

        <div class="theme-selector__dropdown" role="menu">
          <div class="theme-selector__options">
            <button class="theme-selector__option theme-selector__option--original" data-theme-option="light" role="menuitem">
              <span class="theme-selector__option-icon"></span>
              <span class="theme-selector__option-label">
                <span class="theme-selector__option-name">Original Light</span>
                <span class="theme-selector__option-desc">Warm editorial</span>
              </span>
              <span class="theme-selector__option-kbd">1</span>
              <svg class="theme-selector__option-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </button>
            <button class="theme-selector__option theme-selector__option--original" data-theme-option="dark" role="menuitem">
              <span class="theme-selector__option-icon"></span>
              <span class="theme-selector__option-label">
                <span class="theme-selector__option-name">Original Dark</span>
                <span class="theme-selector__option-desc">Reading room</span>
              </span>
              <span class="theme-selector__option-kbd">2</span>
              <svg class="theme-selector__option-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </button>
            
            <div class="theme-selector__divider" role="separator"></div>
            
            <button class="theme-selector__option theme-selector__option--hsbc-light" data-theme-option="hsbc-light" role="menuitem">
              <span class="theme-selector__option-icon"></span>
              <span class="theme-selector__option-label">
                <span class="theme-selector__option-name">HSBC Light</span>
                <span class="theme-selector__option-desc">Professional minimal</span>
              </span>
              <span class="theme-selector__option-kbd">3</span>
              <svg class="theme-selector__option-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </button>
            <button class="theme-selector__option theme-selector__option--hsbc-dark" data-theme-option="hsbc-dark" role="menuitem">
              <span class="theme-selector__option-icon"></span>
              <span class="theme-selector__option-label">
                <span class="theme-selector__option-name">HSBC Dark</span>
                <span class="theme-selector__option-desc">Finance blue-black</span>
              </span>
              <span class="theme-selector__option-kbd">4</span>
              <svg class="theme-selector__option-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <a
        class="site-header__action"
        href="/rss.xml"
        aria-label="RSS Feed"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 11a9 9 0 0 1 9 9"/>
          <path d="M4 4a16 16 0 0 1 16 16"/>
          <circle cx="5" cy="19" r="1"/>
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  /* 保留分隔线样式 */
  .theme-selector__divider {
    height: 1px;
    margin: 6px 0;
    background: var(--color-border);
  }
</style>