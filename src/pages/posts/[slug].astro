---
import { render } from 'astro:content'
import MermaidRuntime from '../../components/MermaidRuntime.astro'
import TableOfContents from '../../components/TableOfContents.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { formatDate, getAllPosts, getReadingTime, toPostPath, trackLabels } from '../../lib/posts'
import { formatTagLabel, getPostTags, toTagPath } from '../../lib/post-tags'
import { toTopicSlug } from '../../lib/slug'

export const getStaticPaths = async () => {
  const posts = await getAllPosts()
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content, headings } = await render(post)
const readingTime = getReadingTime(post.body ?? '')
const ogImage = `/og/${post.data.slug}.svg`
const sectionCount = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3).length
const hasToc = sectionCount >= 3
const tags = getPostTags(post)
const metaTags = [post.data.topic, ...tags].filter((value): value is string => Boolean(value))
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  image={ogImage}
  canonicalPath={toPostPath(post)}
  type="article"
  showProgress
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  tags={metaTags}
>
  <section class="post-shell">
    <article class="post-article">
      <header class="post-hero">
        <div class="post-hero__meta">
          <span>{trackLabels[post.data.track]}</span>
          {post.data.topic && (
            <a href={`/topics/${toTopicSlug(post.data.topic)}`}>{post.data.topic}</a>
          )}
          {post.data.series && <span>{post.data.series}</span>}
        </div>

        <h1>{post.data.title}</h1>
        <p class="post-hero__summary">{post.data.summary}</p>

        <div class="post-hero__facts">
          <span>发布于 {formatDate(post.data.publishedAt)}</span>
          {post.data.updatedAt && <span>更新于 {formatDate(post.data.updatedAt)}</span>}
          <span>{readingTime} 分钟</span>
        </div>
      </header>

      <div class:list={['post-content-grid', hasToc && 'post-content-grid--with-toc']}>
        <div class="post-content-main">
          <div class="prose">
            <Content />
          </div>

          {(post.data.topic || post.data.series || tags.length > 0) && (
            <footer class="post-taxonomy">
              <p class="toc__eyebrow">Cross references</p>
              <div class="post-taxonomy__chips">
                {post.data.topic && (
                  <a href={`/topics/${toTopicSlug(post.data.topic)}`} class="chip">
                    {post.data.topic}
                  </a>
                )}
                {post.data.series && <span class="chip">{post.data.series}</span>}
                {tags.map((tag) => (
                  <a href={toTagPath(tag)} class="chip chip--tag">
                    {formatTagLabel(tag)}
                  </a>
                ))}
              </div>
            </footer>
          )}
        </div>
        {hasToc && (
          <div class="post-content-rail">
            <aside class="reading-brief">
              <p class="toc__eyebrow">Reading brief</p>
              <dl class="reading-brief__facts">
                <div>
                  <dt>Track</dt>
                  <dd>{trackLabels[post.data.track]}</dd>
                </div>
                <div>
                  <dt>Sections</dt>
                  <dd>{sectionCount}</dd>
                </div>
                <div>
                  <dt>Read</dt>
                  <dd>{readingTime} min</dd>
                </div>
                <div>
                  <dt>Updated</dt>
                  <dd>{formatDate(post.data.updatedAt ?? post.data.publishedAt)}</dd>
                </div>
              </dl>

              {post.data.topic && (
                <a class="reading-brief__link" href={`/topics/${toTopicSlug(post.data.topic)}`}>
                  查看 {post.data.topic} 主题
                </a>
              )}

              {tags.length > 0 && (
                <div class="reading-brief__tags">
                  {tags.slice(0, 4).map((tag) => (
                    <a href={toTagPath(tag)} class="chip chip--tag">
                      {formatTagLabel(tag)}
                    </a>
                  ))}
                </div>
              )}
            </aside>
            <TableOfContents headings={headings} />
          </div>
        )}
      </div>
    </article>
  </section>

  <MermaidRuntime />
</BaseLayout>
