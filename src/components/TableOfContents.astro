---
type Heading = {
  depth: number
  slug: string
  text: string
}

const { headings } = Astro.props as { headings: Heading[] }
const outlineHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3 && heading.text !== '目录')
const visibleHeadings =
  outlineHeadings.length > 18
    ? outlineHeadings.filter((heading) => heading.depth === 2)
    : outlineHeadings
---

{visibleHeadings.length >= 3 && (
  <nav class="toc">
    {visibleHeadings.map((heading) => (
      <a
        href={`#${heading.slug}`}
        data-toc-link={heading.slug}
        class:list={['toc__link', heading.depth === 3 && 'toc__link--child']}
      >
        {heading.text}
      </a>
    ))}
  </nav>
)}

<style>
  .toc {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .toc__link {
    display: block;
    padding: 0.5rem 0.7rem;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--color-text-muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    border-radius: var(--radius-sm);
    transition: color var(--duration-fast), background var(--duration-fast), border-color var(--duration-fast);
  }

  .toc__link:hover,
  .toc__link.is-active {
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    border-left-color: var(--color-accent);
  }

  .toc__link--child {
    padding-left: 1.2rem;
    font-size: 0.86rem;
  }
</style>
