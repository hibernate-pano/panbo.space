---
const currentPath = Astro.url.pathname

const navItems = [
  { href: '/archive', label: 'Archive', matches: ['/archive'] },
  { href: '/tags', label: 'Index', matches: ['/topics/', '/tags'] },
  { href: '/about', label: 'About', matches: ['/about'] },
]

const isActive = (matches: string[], href: string) =>
  currentPath === href || matches.some((match) => currentPath === match || currentPath.startsWith(match))
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/">
      <span class="site-header__brand-mark" aria-hidden="true"></span>
      <span class="site-header__brand-name">panbo.space</span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      {navItems.map((item) => (
        <a
          href={item.href}
          data-nav-link
          data-match={item.matches.join(',')}
          class:list={[isActive(item.matches, item.href) && 'is-active']}
          aria-current={isActive(item.matches, item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="site-header__actions">
      <a
        class="site-header__action"
        href="/search"
        aria-label="Search"
        data-nav-link
        data-match="/search"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
        <kbd>⌘K</kbd>
      </a>

      <button
        class="site-header__action"
        type="button"
        data-theme-toggle
        aria-label="Toggle theme"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/>
          <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
        </svg>
      </button>

      <a
        class="site-header__action"
        href="/rss.xml"
        aria-label="RSS Feed"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 11a9 9 0 0 1 9 9"/>
          <path d="M4 4a16 16 0 0 1 16 16"/>
          <circle cx="5" cy="19" r="1"/>
        </svg>
      </a>
    </div>
  </div>
</header>
