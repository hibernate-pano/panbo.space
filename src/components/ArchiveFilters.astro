---
import type { PostEntry } from '../lib/posts'
import type { TrackKey } from '../lib/posts'
import { formatDate, getAvailableTracks, getReadingTime, toPostPath, trackHue, trackLabels } from '../lib/posts'
import { formatTagLabel, getPostTags, getVisiblePostTags, toTagPath } from '../lib/post-tags'
import { toTopicSlug } from '../lib/slug'

type Props = {
  posts: PostEntry[]
  topics: string[]
  tags: string[]
  years: string[]
  popularTags: Array<{
    tag: string
    slug: string
    count: number
  }>
}

const { posts, topics, years } = Astro.props as Props

const trackOptions = await getAvailableTracks()
const trackCount = (key: string) => posts.filter((post) => post.data.track === key).length
const postsByYear = years
  .map((year) => ({
    year,
    posts: posts.filter((post) => String(post.data.publishedAt.getFullYear()) === year),
  }))
  .filter((group) => group.posts.length > 0)
---

<section class="archive-page" data-archive-shell>
  <header class="archive-header">
    <p class="page-header__eyebrow">Archive</p>
    <h1 class="archive-header__title">全部归档</h1>
    <p class="archive-header__summary">按栏目、主题和年份浏览这个档案里的每一篇笔记。</p>
  </header>

  <!-- Track switcher: local tabs, mirrors ?track= URL state -->
  <div class="archive-tracks" role="group" aria-label="按栏目筛选">
    <button type="button" class="archive-track-btn" data-archive-track="" style="--track-hue: var(--accent)">
      <span class="archive-track-btn__dot" aria-hidden="true"></span>
      全部
      <span class="archive-track-btn__count">{posts.length}</span>
    </button>
    {trackOptions.map((key) => (
      <button type="button" class="archive-track-btn" data-archive-track={key} style={`--track-hue: ${trackHue[key as TrackKey]}`}>
        <span class="archive-track-btn__dot" aria-hidden="true"></span>
        {trackLabels[key as TrackKey]}
        <span class="archive-track-btn__count">{trackCount(key)}</span>
      </button>
    ))}
  </div>

  <!-- Current Track Indicator (hidden by default; JS toggles based on ?track= URL) -->
  <div class="archive-track-indicator" data-track-indicator hidden>
    <span class="archive-track-indicator__label">正在筛选</span>
    <strong class="archive-track-indicator__value" data-track-indicator-label></strong>
    <a class="archive-track-indicator__clear" href="/archive" aria-label="Clear track filter">清除</a>
  </div>

  <!-- Hidden track-label map for the indicator -->
  <div class="archive-track-labels" hidden aria-hidden="true">
    {trackOptions.map(key => (
      <span data-track-label={key}>{trackLabels[key]}</span>
    ))}
  </div>

  <!-- Topic Filter Pills -->
  {topics.length > 0 && (
    <div class="archive-filters">
      {topics.slice(0, 8).map((topic) => (
        <button type="button" class="filter-pill" data-topic-shortcut={topic}>
          {topic}
        </button>
      ))}
    </div>
  )}

  <!-- Year Filter Pills -->
  {years.length > 1 && (
    <div class="archive-filters archive-filters--years">
      {years.map((year) => (
        <button type="button" class="filter-pill" data-year-shortcut={year}>
          {year}
        </button>
      ))}
    </div>
  )}

  <!-- Results -->
  <div class="archive-results">
    <p class="archive-count" data-archive-count aria-live="polite">{posts.length} 篇笔记</p>
    <p class="archive-empty" data-archive-empty hidden>没有符合当前筛选条件的笔记。</p>

    <div data-archive-list>
      {postsByYear.map((group) => (
        <section class="archive-year" data-archive-year>
          <header class="archive-year__head">
            <span class="archive-year__year">{group.year}</span>
            <span class="archive-year__count">{group.posts.length} 篇</span>
          </header>

          <div class="archive-year__list">
            {group.posts.map((post) => (
              <article
                class="post-card"
                data-track={post.data.track}
                data-topic={post.data.topic ?? ''}
                data-year={String(post.data.publishedAt.getFullYear())}
                data-tags={getPostTags(post).join('||')}
                style={`--track-hue: ${trackHue[post.data.track]}`}
              >
                <a class="post-card__link" href={toPostPath(post)}>
                  <div class="post-card__meta">
                    <span>{trackLabels[post.data.track]}</span>
                    {post.data.topic && <span>{post.data.topic}</span>}
                    <span>{formatDate(post.data.publishedAt)}</span>
                    <span>{getReadingTime(post.body ?? '')} 分钟</span>
                  </div>
                  <h3 class="post-card__title">{post.data.title}</h3>
                  <p class="post-card__summary">{post.data.summary}</p>
                </a>

                <div class="post-card__footer">
                  <div class="post-card__tags">
                    {post.data.topic && (
                      <a href={`/topics/${toTopicSlug(post.data.topic)}`} class="tag">
                        {post.data.topic}
                      </a>
                    )}
                    {getVisiblePostTags(post, 2).map((tag) => (
                      <a href={toTagPath(tag)} class="tag">
                        {formatTagLabel(tag)}
                      </a>
                    ))}
                  </div>
                  <a class="post-card__readmore" href={toPostPath(post)}>
                    继续阅读 →
                  </a>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  /* Year headings and list rhythm live in global.css */
</style>

<script>
  const shell = document.querySelector<HTMLElement>('[data-archive-shell]')

  if (shell && shell.dataset.ready !== 'true') {
    shell.dataset.ready = 'true'

    const items = [...shell.querySelectorAll<HTMLElement>('.post-card')]
    const count = shell.querySelector<HTMLElement>('[data-archive-count]')
    const empty = shell.querySelector<HTMLElement>('[data-archive-empty]')
    const yearSections = [...shell.querySelectorAll<HTMLElement>('[data-archive-year]')]
    const topicShortcuts = [...shell.querySelectorAll<HTMLButtonElement>('[data-topic-shortcut]')]
    const yearShortcuts = [...shell.querySelectorAll<HTMLButtonElement>('[data-year-shortcut]')]
    const trackButtons = [...shell.querySelectorAll<HTMLButtonElement>('[data-archive-track]')]
    const trackLabelMap: Record<string, string> = {}
    shell.querySelectorAll<HTMLElement>('[data-track-label]').forEach(el => {
      const key = el.dataset.trackLabel
      if (key) trackLabelMap[key] = el.textContent ?? ''
    })
    const trackIndicator = shell.querySelector<HTMLElement>('[data-track-indicator]')
    const trackIndicatorLabel = shell.querySelector<HTMLElement>('[data-track-indicator-label]')
    const params = new URLSearchParams(window.location.search)

    let activeFilters = {
      track: params.get('track') ?? '',
      topic: params.get('topic') ?? '',
      year: params.get('year') ?? '',
    }

    const applyFilters = () => {
      let visible = 0

      for (const item of items) {
        const matches =
          (!activeFilters.track || item.dataset.track === activeFilters.track) &&
          (!activeFilters.topic || item.dataset.topic === activeFilters.topic) &&
          (!activeFilters.year || item.dataset.year === activeFilters.year)

        item.style.display = matches ? '' : 'none'
        if (matches) visible += 1
      }

      if (count) {
        count.textContent = `${visible} 篇笔记`
      }

      if (empty) {
        empty.hidden = visible > 0
      }

      // Toggle the track indicator based on the active track filter
      if (trackIndicator && trackIndicatorLabel) {
        if (activeFilters.track && trackLabelMap[activeFilters.track]) {
          trackIndicatorLabel.textContent = trackLabelMap[activeFilters.track]
          trackIndicator.hidden = false
        } else {
          trackIndicator.hidden = true
        }
      }

      for (const section of yearSections) {
        const visibleItems = [...section.querySelectorAll<HTMLElement>('.post-card')].some((item) => item.style.display !== 'none')
        section.style.display = visibleItems ? '' : 'none'
      }

      // Update track switcher active state
      for (const btn of trackButtons) {
        btn.classList.toggle('is-active', (btn.dataset.archiveTrack ?? '') === activeFilters.track)
      }

      // Update shortcut states
      for (const btn of trackButtons) {
      btn.addEventListener('click', () => {
        const value = btn.dataset.archiveTrack ?? ''
        activeFilters.track = activeFilters.track === value ? '' : value
        applyFilters()
      })
    }

    for (const shortcut of topicShortcuts) {
        const value = shortcut.dataset.topicShortcut ?? ''
        shortcut.classList.toggle('is-active', activeFilters.topic === value)
      }

      for (const shortcut of yearShortcuts) {
        const value = shortcut.dataset.yearShortcut ?? ''
        shortcut.classList.toggle('is-active', activeFilters.year === value)
      }

      const nextParams = new URLSearchParams()
      if (activeFilters.track) nextParams.set('track', activeFilters.track)
      if (activeFilters.topic) nextParams.set('topic', activeFilters.topic)
      if (activeFilters.year) nextParams.set('year', activeFilters.year)
      const nextUrl = nextParams.toString() ? `${window.location.pathname}?${nextParams.toString()}` : window.location.pathname
      window.history.replaceState({}, '', nextUrl)
    }

    for (const shortcut of topicShortcuts) {
      shortcut.addEventListener('click', () => {
        const value = shortcut.dataset.topicShortcut ?? ''
        activeFilters.topic = activeFilters.topic === value ? '' : value
        applyFilters()
      })
    }

    for (const shortcut of yearShortcuts) {
      shortcut.addEventListener('click', () => {
        const value = shortcut.dataset.yearShortcut ?? ''
        activeFilters.year = activeFilters.year === value ? '' : value
        applyFilters()
      })
    }

    applyFilters()
  }
</script>
